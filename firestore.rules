rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== FUNÇÕES =====================
    // "Logado" = tem acesso ao sistema = tem CRACHÁ (usuarios/{uid}) e o crachá não está bloqueado.
    // Vale para TODO tipo de login (Google ou e-mail e senha): qualquer pessoa consegue criar uma conta
    // de login por fora das telas, então só estar autenticado não basta. Sem crachá (nunca aprovado,
    // líder removido, login antigo de unidade desligado) ou com papel "bloqueado" = não lê nem grava nada.
    // Custa 1 leitura por pedido ao banco (o Firebase cobra o crachá uma vez só por pedido, mesmo que a
    // regra o consulte mais de uma vez).
    function autenticado() { return request.auth != null; }
    function temCracha() { return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    // Mentor com status "inativo" (aba Mentores) também fica sem acesso. Sem leitura extra: é o mesmo crachá.
    // Professor só tem acesso pelo login do Google aprovado (loginGoogle == true). Crachá de professor do login
    // antigo (e-mail e senha) não vale: a pessoa apaga o crachá antigo e pede acesso de novo.
    function crachaAtivo(c) {
      let r = c.get('role', '').lower();
      return r != 'bloqueado'
        && !(r == 'mentor' && c.get('status', '') == 'inativo')
        && !(r == 'professor' && c.get('loginGoogle', false) != true)
        // Líder temporário: depois do prazo (temporarioAte) o crachá deixa de valer sozinho, sem rotina nem função na nuvem.
        && (!('temporarioAte' in c) || c.temporarioAte > request.time);
    }
    function logado() {
      return autenticado() && temCracha()
        && crachaAtivo(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data);
    }

    // Papel de quem está fazendo a ação, lido do crachá (usuarios/{uid}).
    // Custa 1 leitura, e só é usado ao GRAVAR em usuarios (nunca nas leituras do dia a dia).
    // COBERTURA (mentor temporário): crachá com coberturaMentorId + coberturaAte (só o admin grava). Enquanto o prazo
    // vale, a pessoa age como "mentor" e enxerga também as unidades do mentor coberto; passou o prazo, volta sozinha
    // ao papel de verdade (sem rotina, sem função na nuvem).
    function coberturaAtiva(c) {
      return c.get('coberturaMentorId', '') is string && c.get('coberturaMentorId', '') != ''
        && 'coberturaAte' in c && c.coberturaAte > request.time;
    }
    // (O caminho de quem NÃO tem cobertura é o mais curto possível: as regras têm limite de 1000 verificações.)
    function papelComCobertura(c) {
      return coberturaAtiva(c) && !(c.get('role', '').lower() in ['admin', 'administrador', 'master']) ? 'mentor' : c.get('role', '').lower();
    }
    function meuPapel() {
      let c = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return 'coberturaMentorId' in c ? papelComCobertura(c) : c.get('role', '').lower();
    }
    function souAdmin() { return logado() && meuPapel() in ['admin', 'administrador', 'master']; }
    // Líder = perfil novo "lider" ou o antigo "unidade" (valem igual durante a transição).
    function papeisLider() { return ['lider', 'unidade']; }
    // Professor não grava cadastros (aulas, unidades, professores, modalidades, feriados...).
    // Quem não tem crachá em usuarios segue como antes (não é tratado como professor).
    function souProfessor() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && meuPapel() == 'professor';
    }
    // Id de mentor que vale para o logado: o dele mesmo, ou o do 1º mentor se ele é 2º mentor (crachá com
    // mentorPrincipalId; só o admin grava esse campo). O 2º mentor enxerga/faz o mesmo que o 1º nas unidades dele.
    function meuMentorId() {
      let c = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return c.get('mentorPrincipalId', '') is string && c.get('mentorPrincipalId', '') != '' ? c.mentorPrincipalId : request.auth.uid;
    }
    // Este id de mentor é um dos que o logado enxerga? (o dele, o do 1º mentor se é 2º, ou o mentor coberto)
    function ehMeuMentor(id) {
      let c = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return id is string && id != ''
        && (id == (c.get('mentorPrincipalId', '') == '' ? request.auth.uid : c.mentorPrincipalId)
          || ('coberturaMentorId' in c && id == c.coberturaMentorId && coberturaAtiva(c)));
    }
    // O mentor logado é o mentor desta unidade? (id vazio = não)
    function mentorDaUnidadeId(unidadeId) {
      return unidadeId is string && unidadeId != ''
        && ehMeuMentor(get(/databases/$(database)/documents/unidades/$(unidadeId)).data.get('mentorId', ''));
    }
    // Quem não é admin não cria crachá já com cobertura (só o admin concede).
    function semCobertura() {
      return !('coberturaMentorId' in request.resource.data) && !('coberturaAte' in request.resource.data);
    }
    function papelDoAlvo() { return resource.data.get('role', '').lower(); }
    function papelNovo() { return request.resource.data.get('role', '').lower(); }
    // CLT ou Saver do professor (src/utils/contrato.js): tipo conhecido e, no máximo, 5 unidades de Saver. O resto é conferido na tela.
    function contratoValido(d) {
      return d.get('tipoContrato', 'clt') in ['clt', 'saver']
        && d.get('saverLocais', []) is list && d.get('saverLocais', []).size() <= 5;
    }
    function camposAlterados() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Mentor de alguma das unidades (até 5) de uma lista.
    function mentorDeAlguma(ids) {
      return ids is list && ids.size() >= 1
        && (mentorDaUnidadeId(ids[0])
          || (ids.size() > 1 && mentorDaUnidadeId(ids[1]))
          || (ids.size() > 2 && mentorDaUnidadeId(ids[2]))
          || (ids.size() > 3 && mentorDaUnidadeId(ids[3]))
          || (ids.size() > 4 && mentorDaUnidadeId(ids[4])));
    }
    // Mentor de TODAS as unidades (até 5) de uma lista (líder temporário: o mentor só convida para unidades dele).
    function mentorDeTodas(ids) {
      return ids is list && ids.size() >= 1 && ids.size() <= 5
        && mentorDaUnidadeId(ids[0])
        && (ids.size() < 2 || mentorDaUnidadeId(ids[1]))
        && (ids.size() < 3 || mentorDaUnidadeId(ids[2]))
        && (ids.size() < 4 || mentorDaUnidadeId(ids[3]))
        && (ids.size() < 5 || mentorDaUnidadeId(ids[4]));
    }
    // Unidades de um líder (pelo crachá dele); vazio se a pessoa não é líder.
    function unidadesDoLiderUid(uid) {
      let a = get(/databases/$(database)/documents/usuarios/$(uid)).data;
      return !(a.get('role', '').lower() in papeisLider()) ? []
        : ('unidadeIds' in a ? a.unidadeIds : (a.get('unidadeId', '') == '' ? [] : [a.unidadeId]));
    }
    // Mentor de alguma unidade desse líder.
    function mentorDoLider(uid) {
      return logado() && meuPapel() == 'mentor' && exists(/databases/$(database)/documents/usuarios/$(uid))
        && mentorDeAlguma(unidadesDoLiderUid(uid));
    }
    function idsDoPedido(p) { return p.get('unidadeIds', [p.get('unidadeId', '')]); }
    // Mentor de alguma das unidades (até 5) de um pedido de líder.
    function mentorDoPedido(p) {
      let ids = idsDoPedido(p);
      return logado() && meuPapel() == 'mentor' && p.get('papel', 'lider') in ['lider', 'professor']
        && ids is list && ids.size() >= 1
        && (mentorDaUnidadeId(ids[0])
          || (ids.size() > 1 && mentorDaUnidadeId(ids[1]))
          || (ids.size() > 2 && mentorDaUnidadeId(ids[2]))
          || (ids.size() > 3 && mentorDaUnidadeId(ids[3]))
          || (ids.size() > 4 && mentorDaUnidadeId(ids[4])));
    }
    // Pedido de PROFESSOR (1 unidade): o líder dessa unidade também aprova (além do mentor e do admin).
    function liderDoPedidoProfessor(p) {
      return logado() && meuPapel() in papeisLider() && p.get('papel', 'lider') == 'professor'
        && p.get('unidadeId', '') is string && p.get('unidadeId', '') != ''
        && p.get('unidadeId', '') in unidadesDoLiderUid(request.auth.uid);
    }
    // Documento de identificação (CPF no Brasil, DNI na Argentina, SSN nos EUA). Fica numa gaveta privada
    // (coleção documentos_privados/{uid}), nunca no crachá aberto. Quem mexe: a própria pessoa, o admin e o
    // mentor dos líderes das unidades dele. Os dígitos são conferidos na tela; aqui só o formato.
    function documentoFormatoOk(d) {
      return d.tipo is string && d.numero is string
        && ((d.tipo == 'cpf' && d.numero.matches('^[0-9]{11}$'))
          || (d.tipo == 'dni' && d.numero.matches('^[0-9]{7,8}$'))
          || (d.tipo == 'ssn' && d.numero.matches('^[0-9]{9}$')));
    }
    function documentoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'numero', 'atualizadoEm', 'atualizadoPor']) && documentoFormatoOk(d)
        && d.get('atualizadoPor', request.auth.uid) == request.auth.uid;
    }
    function caminhoDocumentoUsuario(uid) { return /databases/$(database)/documents/documentos_privados/$(uid); }

    // Convite de mentor (convites_acesso/{e-mail Google}): só o admin cria. Vale para quem entrou AGORA
    // pelo Google com esse e-mail (verificado pelo Google).
    function emailGoogleVerificado() {
      return autenticado()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string && request.auth.token.email.size() > 3;
    }
    function caminhoConvite() { return /databases/$(database)/documents/convites_acesso/$(request.auth.token.email.lower()); }
    function mentorAceitaConvite(uid) {
      let d = request.resource.data;
      let c = get(caminhoConvite()).data;
      return emailGoogleVerificado() && request.auth.uid == uid
        && exists(caminhoConvite())
        && c.status == 'pendente' && c.papel == 'mentor'
        && d.keys().hasOnly(['nome', 'email', 'telefone', 'pais', 'role', 'status', 'loginGoogle', 'criadoPor', 'criadoEm', 'mentorPrincipalId'])
        && d.role == 'mentor' && d.status == 'ativo' && d.loginGoogle == true
        && d.email == request.auth.token.email.lower()
        && d.nome == c.nome && d.telefone == c.telefone && d.get('pais', '') == c.get('pais', '')
        && d.criadoPor == c.criadoPor
        // 2º mentor novo: o convite diz de qual mentor ele é o 2º (só o admin cria o convite); sem isso, não pode ter o campo.
        && d.get('mentorPrincipalId', '') == c.get('mentorPrincipalId', '')
        // O convite precisa ser marcado como usado na MESMA gravação (não serve duas vezes).
        && getAfter(caminhoConvite()).data.status == 'usado';
    }

    // Líder TEMPORÁRIO: o admin ou o mentor das unidades cadastra o e-mail do Google (convites_acesso, papel 'lider');
    // no 1º acesso a pessoa cria o PRÓPRIO crachá, com as unidades e o prazo do convite (e nada além disso).
    function liderTemporarioAceitaConvite(uid) {
      let d = request.resource.data;
      let c = get(caminhoConvite()).data;
      return emailGoogleVerificado() && request.auth.uid == uid
        && exists(caminhoConvite())
        && c.status == 'pendente' && c.papel == 'lider' && 'temporarioAte' in c && c.temporarioAte > request.time
        && d.keys().hasOnly(['nome', 'email', 'telefone', 'pais', 'role', 'loginGoogle', 'criadoPor', 'criadoEm', 'unidadeId', 'unidadeIds', 'temporarioAte', 'temporarioDesde'])
        && d.role == 'lider' && d.loginGoogle == true
        && d.email == request.auth.token.email.lower()
        && d.nome == c.nome && d.telefone == c.telefone && d.get('pais', '') == c.get('pais', '')
        && d.criadoPor == c.criadoPor
        && d.unidadeIds == c.unidadeIds && d.unidadeId == c.unidadeIds[0]
        && d.temporarioAte == c.temporarioAte && d.temporarioDesde == request.time
        && getAfter(caminhoConvite()).data.status == 'usado';
    }

    // ===================== PÁGINA PÚBLICA DE HORÁRIOS =====================
    // Sem login, a página de horários lê só: a "vitrine" (nome/endereço das unidades e nome dos
    // professores), a cópia pública das aulas (aulas_publicas, sem o valor) e as modalidades. Os cadastros completos de unidades e professores
    // (com e-mail, telefone e login) exigem login.
    match /publico/{docId} {
      allow read: if true;
      allow write: if logado() && meuPapel() in ['admin', 'administrador', 'master', 'mentor', 'lider', 'unidade'];
    }
    // Aulas: cada um grava só as da própria unidade (admin: todas). Ninguém além do admin apaga de verdade
    // (a tela "exclui" marcando excluido:true). Esta regra é a única que libera gravar em aulas: a coleção está na
    // lista de exceções da regra-curinga lá embaixo.
    function podeGravarAulaDa(unidadeId) {
      return souAdmin()
        || (unidadeId is string && unidadeId != '' && logado()
            && ((meuPapel() == 'mentor' && mentorDaUnidadeId(unidadeId))
                || (meuPapel() in papeisLider()
                    && (unidadeId == meuUsuario().get('unidadeId', '') || unidadeId in meuUsuario().get('unidadeIds', [])))));
    }
    // Modalidade da aula tem que estar habilitada na unidade (campo modalidadesIds). Unidade sem o campo = ainda
    // não configurada: vale qualquer uma. O admin fica de fora (restaurar backup, correções).
    function modalidadeLiberadaNaUnidade(unidadeId, modalidadeId) {
      return souAdmin()
        || get(/databases/$(database)/documents/unidades/$(unidadeId)).data.get('modalidadesIds', null) == null
        || modalidadeId in get(/databases/$(database)/documents/unidades/$(unidadeId)).data.get('modalidadesIds', []);
    }
    match /aulas/{aulaId} {
      // Tem o valor que cada professor recebe: só quem está logado. A página pública lê aulas_publicas (sem valor).
      allow read: if logado();
      allow create: if podeGravarAulaDa(request.resource.data.get('unidadeId', ''))
        && modalidadeLiberadaNaUnidade(request.resource.data.get('unidadeId', ''), request.resource.data.get('modalidadeId', ''));
      // Editar: a unidade de antes E a de depois têm que ser dele (senão dava para "jogar" aula na unidade dos outros).
      // Só confere a modalidade se ela (ou a unidade) mudou: aula antiga continua editável (hora, valor, datas).
      allow update: if podeGravarAulaDa(resource.data.get('unidadeId', ''))
        && podeGravarAulaDa(request.resource.data.get('unidadeId', ''))
        && ((request.resource.data.get('modalidadeId', '') == resource.data.get('modalidadeId', '')
              && request.resource.data.get('unidadeId', '') == resource.data.get('unidadeId', ''))
            || modalidadeLiberadaNaUnidade(request.resource.data.get('unidadeId', ''), request.resource.data.get('modalidadeId', '')));
      allow delete: if souAdmin();
    }
    // Cópia pública da grade (sem o valor da aula), lida pela página de horários sem login.
    // Gravada junto com a aula (mesma operação) por quem pode gravar a aula daquela unidade. Ver services/aulasPublicas.js.
    match /aulas_publicas/{aulaId} {
      allow read: if true;
      allow create, update: if podeGravarAulaDa(request.resource.data.get('unidadeId', ''))
        && !('valor' in request.resource.data)
        && (resource == null || podeGravarAulaDa(resource.data.get('unidadeId', '')));
      allow delete: if souAdmin() || podeGravarAulaDa(resource.data.get('unidadeId', ''));
    }
    match /modalidades/{document=**} {
      allow read: if true;
      allow write: if souAdmin(); // a aba Modalidades é só do admin
    }
    // Modalidades habilitadas na unidade: campo "modalidadesIds" (e os dois de controle). Só o ADMIN altera numa
    // unidade que já existe. Ao criar a unidade, mentor só pode começar com modalidades da lista básica da rede
    // (configuracoes/modalidadesBasicas). Unidade sem o campo continua valendo (ainda não migrada).
    // A coleção está na lista de exceções da regra-curinga lá embaixo; esta é a única regra que libera gravar nela.
    function camposDeModalidadeDaUnidade() { return ['modalidadesIds', 'modalidadesAtualizadoEm', 'modalidadesAtualizadoPor']; }
    function modalidadesIniciaisPermitidas() {
      let ids = request.resource.data.get('modalidadesIds', null);
      return ids == null
        || (ids is list
            && exists(/databases/$(database)/documents/configuracoes/modalidadesBasicas)
            && ids.toSet().difference(get(/databases/$(database)/documents/configuracoes/modalidadesBasicas).data.get('ids', []).toSet()).size() == 0);
    }
    // Quem grava em "unidades" (Etapa 1 das regras por unidade):
    //  - admin: tudo;
    //  - mentor (inclusive 2º mentor e quem tem cobertura): cria, edita e apaga SÓ as unidades dele (mentorId), e não troca o
    //    mentor da unidade (quem redistribui unidades é o admin); as modalidades continuam só do admin;
    //  - líder: só os campos de líder da PRÓPRIA unidade (atualização de cadastro, saída da função, desfazer saída).
    // Professor não grava. Ninguém mais.
    function camposDeLiderDaUnidade() {
      return ['liderUid', 'liderNome', 'liderEmail', 'liderTelefone', 'liderTipo', 'liderDesde', 'liderAConferir',
              'lider2Uid', 'lider2Nome', 'lider2Email', 'lider2Telefone', 'lider2Tipo', 'lider2Desde',
              'loginAntigoDesligado', 'loginAntigoDesligadoEm'];
    }
    // Usa o papel de VERDADE do crachá (não o efetivo): quem tem cobertura de mentor continua líder da própria unidade.
    function liderDestaUnidade(unidadeId) {
      let c = meuUsuario();
      return c.get('role', '').lower() in papeisLider() && (unidadeId == c.get('unidadeId', '') || unidadeId in c.get('unidadeIds', []));
    }
    match /unidades/{unidadeId} {
      allow read: if logado();
      allow create: if souAdmin()
        || (logado() && meuPapel() == 'mentor' && ehMeuMentor(request.resource.data.get('mentorId', ''))
            && modalidadesIniciaisPermitidas());
      allow update: if souAdmin()
        || (logado() && meuPapel() == 'mentor' && ehMeuMentor(resource.data.get('mentorId', ''))
            && request.resource.data.get('mentorId', '') == resource.data.get('mentorId', '')
            && !camposAlterados().hasAny(camposDeModalidadeDaUnidade()))
        || (logado() && liderDestaUnidade(unidadeId) && camposAlterados().hasOnly(camposDeLiderDaUnidade()));
      allow delete: if souAdmin()
        || (logado() && meuPapel() == 'mentor' && ehMeuMentor(resource.data.get('mentorId', '')));
      // Se algum dia houver subcoleção dentro de uma unidade: lê quem está logado, grava só o admin.
      match /{sub=**} {
        allow read: if logado();
        allow write: if souAdmin();
      }
    }
    // Lista básica de modalidades da rede (usada nas unidades novas). Todos os logados leem; só o admin grava.
    match /configuracoes/{docId} {
      allow read: if logado();
      allow write: if souAdmin();
    }
    // Ficha do professor (Etapa 2 das regras por unidade). Mentor e líder criam e editam só os campos de CONTATO e de
    // vínculo com o login (nome, e-mail, país, telefone, status, uidLogin, documentoOk, workshops, contrato CLT/Saver e as marcas de data);
    // qualquer outro campo, e apagar a ficha, é só do admin (que também junta fichas e liga crachás).
    function camposDeFichaDoProfessor() {
      return ['nome', 'email', 'pais', 'telefone', 'status', 'documentoOk', 'uidLogin', 'workshops',
              'updatedAt', 'createdAt', 'createdBy', 'roleCreator', 'tipoContrato', 'saverLocais'];
    }
    match /professores/{professorId} {
      allow read: if logado();
      // "documentoOk" só vale com o documento guardado na gaveta privada da ficha (documentos_ficha).
      allow create: if logado() && !souProfessor()
        && (souAdmin() || request.resource.data.keys().hasOnly(camposDeFichaDoProfessor()))
        && (request.resource.data.get('documentoOk', false) != true
            || existsAfter(/databases/$(database)/documents/documentos_ficha/$(professorId)));
      allow update: if logado() && !souProfessor()
        && (souAdmin() || camposAlterados().hasOnly(camposDeFichaDoProfessor()))
        && (request.resource.data.get('documentoOk', false) != true
            || existsAfter(/databases/$(database)/documents/documentos_ficha/$(professorId)));
      allow delete: if souAdmin();
    }

    // Vínculo professor × unidade (Etapa 2). Cria e apaga: admin, mentor da unidade e líder da unidade. Nunca se edita
    // (só o admin, ao juntar fichas). Lê quem está logado.
    function podeMexerNaUnidade(unidadeId) {
      return unidadeId is string && unidadeId != '' && logado()
        && ((meuPapel() == 'mentor' && mentorDaUnidadeId(unidadeId)) || liderDestaUnidade(unidadeId));
    }
    match /vinculos/{vinculoId} {
      allow read: if logado();
      allow create: if souAdmin()
        || (request.resource.data.keys().hasOnly(['professorId', 'unidadeId', 'status', 'createdAt'])
            && podeMexerNaUnidade(request.resource.data.get('unidadeId', '')));
      allow update: if souAdmin();
      allow delete: if souAdmin() || podeMexerNaUnidade(resource.data.get('unidadeId', ''));
    }

    // ===================== FERIADOS =====================
    // Feriado cancela aula (sem pagamento e sem pendência) em todas as unidades do alcance dele, então só o admin
    // cria, edita ou apaga. Todo mundo que está logado lê (as telas calculam o feriado na hora). O mentor usa
    // feriados_propostas (logo abaixo). Esta coleção está na lista de exceções da regra-curinga.
    match /feriados/{feriadoId} {
      allow read: if logado();
      allow write: if souAdmin();
    }

    // ===================== PROPOSTAS DE FERIADO (mentor propõe, admin decide) =====================
    // Só o admin cria feriado de verdade (coleção feriados). O mentor PROPÕE aqui: a proposta não afeta aula nenhuma
    // (nenhuma tela de aulas lê esta coleção); o admin aprova (vira feriado) ou recusa. Cada mentor só enxerga as próprias.
    match /feriados_propostas/{propostaId} {
      function souMentor() { return logado() && meuPapel() == 'mentor'; }
      allow read: if souAdmin() || (souMentor() && resource.data.get('propostoPor', '') == request.auth.uid);
      allow create: if souMentor()
        && request.resource.data.get('propostoPor', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pendente'
        && request.resource.data.get('escopo', '') in ['cidade', 'unidades'];
      allow update: if souAdmin();
      // O mentor desiste de uma proposta que ainda está pendente.
      allow delete: if souAdmin() || (souMentor() && resource.data.get('propostoPor', '') == request.auth.uid
        && resource.data.get('status', '') == 'pendente');
    }

    // ===================== VALIDAÇÕES (presença e pagamento) =====================
    // Mesma regra de prazo da tela (src/utils/validacoes.js):
    // - professor: só aulas em que é TITULAR, do mês atual até hoje; não muda o valor da aula,
    //   não lança aulão, não mexe em aula cancelada e não apaga nada;
    // - líder (unidade): só a própria unidade, até 60 dias para trás; mês já fechado exige justificativa;
    // - mentor: só as unidades dele, sem limite de dias para trás, nunca data futura; mês já fechado exige
    //   justificativa; aula da grade tem que ser daquela unidade e não muda o valor da aula (igual ao líder);
    // - admin: tudo (inclusive restaurar backup).
    // Datas no fuso do Brasil/Argentina (UTC-3).
    function agoraLocal() { return request.time - duration.value(3, 'h'); }
    function hojeLocal() { let a = agoraLocal(); return timestamp.date(a.year(), a.month(), a.day()); }
    function inicioDoMes() { let a = agoraLocal(); return timestamp.date(a.year(), a.month(), 1); }
    function diaDa(dataStr) {
      let p = dataStr.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    function meuUsuario() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function aulaDa(aulaId) { return get(/databases/$(database)/documents/aulas/$(aulaId)).data; }

    function dataValida(d) { return d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function justificada(d) { return d.get('justificativa', '') is string && d.get('justificativa', '').size() >= 10; }
    // Alunos: inteiro de 0 a 150 nas aulas da grade (aulão fica livre). Não mexer no número antigo também passa.
    function alunosOk(d) {
      return !('alunos' in d) || d.get('isAulao', false) == true
        || (d.alunos is int && d.alunos >= 0 && d.alunos <= 150)
        || (resource != null && resource.data.get('alunos', null) == d.alunos);
    }
    // Valor da aula: o mesmo do cronograma ou o que já estava gravado (valor da época).
    function valorOk(d, aula) {
      return d.get('valorEfetivo', 0) == aula.get('valor', 0)
        || (aula.get('valor', 0) is string && float(aula.valor) == d.get('valorEfetivo', 0))
        || (resource != null && d.get('valorEfetivo', 0) == resource.data.get('valorEfetivo', -1));
    }
    // Na criação, o documento da aula da grade tem ID fixo "<aulaId>_<data>".
    function idCerto(vid, d) { return resource != null || d.get('isAulao', false) == true || vid == d.aulaId + '_' + d.data; }
    // Na edição não se troca a aula nem o dia.
    function mesmaAulaEDia(d) {
      return resource == null || (resource.data.get('aulaId', null) == d.get('aulaId', null) && resource.data.data == d.data);
    }

    function souTitularDa(aula) {
      return aula.get('professorId', '') != ''
        && (meuUsuario().get('professorId', '') == aula.professorId
            || get(/databases/$(database)/documents/professores/$(aula.professorId)).data.get('uidLogin', '') == request.auth.uid);
    }

    function professorPodeGravar(vid, d) {
      let aula = aulaDa(d.aulaId);
      return meuPapel() == 'professor'
        && d.get('isAulao', false) != true
        && idCerto(vid, d) && mesmaAulaEDia(d)
        && diaDa(d.data) >= inicioDoMes() && diaDa(d.data) <= hojeLocal()
        && souTitularDa(aula)
        && d.unidadeId == aula.unidadeId
        && d.status in ['realizada', 'cancelada']
        && (d.get('substituicao', false) == true
              ? d.get('professorOriginalId', '') == aula.professorId
              : d.professorId == aula.professorId)
        && valorOk(d, aula)
        && (resource == null || resource.data.get('status', '') != 'cancelada');
    }

    function liderPodeGravar(vid, d) {
      return meuPapel() in papeisLider()
        && (d.unidadeId == meuUsuario().get('unidadeId', '') || d.unidadeId in meuUsuario().get('unidadeIds', []))
        && idCerto(vid, d) && mesmaAulaEDia(d)
        && diaDa(d.data) <= hojeLocal()
        && diaDa(d.data) >= hojeLocal() - duration.value(60, 'd')
        && (diaDa(d.data) >= inicioDoMes() || justificada(d))
        && (d.get('isAulao', false) == true || aulaDa(d.aulaId).unidadeId == d.unidadeId)
        && (d.get('isAulao', false) == true || valorOk(d, aulaDa(d.aulaId)));
    }

    function mentorPodeGravar(vid, d) {
      return meuPapel() == 'mentor'
        && ehMeuMentor(get(/databases/$(database)/documents/unidades/$(d.unidadeId)).data.get('mentorId', ''))
        && idCerto(vid, d) && mesmaAulaEDia(d)
        && diaDa(d.data) <= hojeLocal()
        && (diaDa(d.data) >= inicioDoMes() || justificada(d))
        && (d.get('isAulao', false) == true || aulaDa(d.aulaId).unidadeId == d.unidadeId)
        && (d.get('isAulao', false) == true || valorOk(d, aulaDa(d.aulaId)));
    }

    function podeGravarValidacao(vid) {
      let d = request.resource.data;
      return souAdmin()
        || (logado() && dataValida(d) && d.get('validadoPor', '') == request.auth.uid && alunosOk(d)
            && (professorPodeGravar(vid, d) || liderPodeGravar(vid, d) || mentorPodeGravar(vid, d)));
    }

    match /validacoes/{vid} {
      allow read: if logado();
      allow create, update: if podeGravarValidacao(vid);
      // Apagar = "reverter cancelamento" (só admin e mentor da unidade, como na tela).
      allow delete: if souAdmin()
        || (logado() && meuPapel() == 'mentor'
            && ehMeuMentor(get(/databases/$(database)/documents/unidades/$(resource.data.unidadeId)).data.get('mentorId', '')));
    }

    // ===================== CRACHÁS (usuarios) =====================
    // Ninguém muda o próprio papel nem se promove. Espelha o que as telas já fazem:
    // - admin: tudo (Mentores, Controle de Acessos, correções)
    // - mentor: cria/edita logins de líder e de professor; exclui login de líder (ao excluir a unidade)
    // - líder (lider/unidade): cria/edita logins de professor
    match /usuarios/{uid} {
      // Cada um sempre pode ler o próprio crachá (quem entrou pelo Google descobre se já foi aprovado).
      allow read: if logado() || (autenticado() && request.auth.uid == uid);

      // ---------- Liderança de várias unidades ----------
      // O crachá do líder guarda a unidade principal em "unidadeId" e TODAS as que ele comanda em "unidadeIds"
      // (a principal é sempre a 1ª da lista). Crachá antigo só tem "unidadeId". Uma unidade pode ter 2 líderes.
      function unidadesDoAlvo() {
        return !(papelDoAlvo() in papeisLider()) ? []
          : ('unidadeIds' in resource.data ? resource.data.unidadeIds
            : (resource.data.get('unidadeId', '') == '' ? [] : [resource.data.unidadeId]));
      }
      // O vínculo com o cadastro de professor é verdadeiro: professores/{professorId}.uidLogin == este login.
      function vinculoDeProfessorOk(uid) {
        return request.resource.data.get('professorId', '') is string
          && request.resource.data.get('professorId', '') != ''
          && get(/databases/$(database)/documents/professores/$(request.resource.data.professorId)).data.get('uidLogin', '') == uid;
      }
      // O mentor mexe em UMA unidade por vez ("unidadeAlterada"), e só numa unidade DELE:
      //  - entra: professor ou líder (de outra unidade, mesmo de outro mentor) passa a ser líder também desta;
      //  - sai, mas continua líder das outras unidades;
      //  - sai da única unidade: o líder que também é professor volta a ser professor.
      // A lista nova tem que ser exatamente a antiga mais (ou menos) essa unidade; nenhum outro campo muda.
      function mentorMudaLideranca(uid) {
        let novo = request.resource.data;
        let x = novo.get('unidadeAlterada', '');
        let antes = unidadesDoAlvo();
        let depois = novo.get('unidadeIds', []);
        return camposAlterados().hasOnly(['role', 'unidadeId', 'unidadeIds', 'professorId', 'unidadeAlterada'])
          && mentorDaUnidadeId(x)
          && (
            (!(x in antes) && depois == antes.concat([x])
              && papelNovo() == 'lider' && novo.get('unidadeId', '') == depois[0]
              && ((papelDoAlvo() in papeisLider() && novo.get('professorId', '') == resource.data.get('professorId', ''))
                  || (papelDoAlvo() == 'professor' && vinculoDeProfessorOk(uid))))
            || (x in antes && depois == antes.removeAll([x]) && depois.size() > 0
              && papelNovo() == papelDoAlvo() && novo.get('unidadeId', '') == depois[0]
              && novo.get('professorId', '') == resource.data.get('professorId', ''))
            || (antes == [x] && papelNovo() == 'professor' && vinculoDeProfessorOk(uid)
              && !('unidadeId' in novo) && !('unidadeIds' in novo))
          );
      }

      // Líder temporário (crachá com temporarioAte): o mentor de TODAS as unidades dele prorroga/encerra (muda só
      // temporarioAte, no máximo 61 dias à frente) ou efetiva como líder de verdade (apaga temporarioAte e temporarioDesde).
      function mentorMexeNoTemporario() {
        let novo = request.resource.data;
        return 'temporarioAte' in resource.data && papelDoAlvo() in papeisLider()
          && mentorDeTodas(unidadesDoAlvo())
          && (
            (camposAlterados().hasOnly(['temporarioAte']) && 'temporarioAte' in novo && novo.temporarioAte is timestamp
              && novo.temporarioAte <= request.time + duration.value(3650, 'd'))
            || (camposAlterados().hasOnly(['temporarioAte', 'temporarioDesde'])
              && !('temporarioAte' in novo) && !('temporarioDesde' in novo))
          );
      }

      // ---------- Saída da função ("não sou mais da unidade" / "não sou mais mentor") ----------
      // A PRÓPRIA pessoa se tira do acesso, na hora, sem apagar o crachá (para dar para desfazer):
      //  - líder: vira 'bloqueado', ou volta a ser 'professor' se também é professor (perde só a liderança);
      //  - mentor: fica com status 'inativo' (já é sem acesso, ver crachaAtivo).
      // O crachá guarda de onde ela saiu (papelAntes, unidadeIdsAntes, saidaEm) e o aviso fica em saidas_acesso.
      function saidaDaFuncao(uid) {
        let novo = request.resource.data;
        let antes = unidadesDoAlvo();
        return request.auth.uid == uid
          && novo.get('saidaEm', null) == request.time
          && novo.get('papelAntes', '') == papelDoAlvo()
          && (
            (papelDoAlvo() in papeisLider() && papelNovo() == 'bloqueado'
              && camposAlterados().hasOnly(['role', 'papelAntes', 'unidadeIdsAntes', 'saidaEm'])
              && novo.get('unidadeIdsAntes', []) == antes)
            || (papelDoAlvo() in papeisLider() && papelNovo() == 'professor' && vinculoDeProfessorOk(uid)
              && camposAlterados().hasOnly(['role', 'unidadeId', 'unidadeIds', 'professorId', 'papelAntes', 'unidadeIdsAntes', 'saidaEm'])
              && novo.get('unidadeIdsAntes', []) == antes
              && !('unidadeId' in novo) && !('unidadeIds' in novo))
            || (papelDoAlvo() == 'mentor' && papelNovo() == 'mentor' && novo.get('status', '') == 'inativo'
              && camposAlterados().hasOnly(['status', 'papelAntes', 'saidaEm']))
          );
      }
      // Desfazer a saída de um LÍDER (mentor de uma das unidades dele): volta a função e as unidades de antes.
      function mentorDesfazSaida() {
        let novo = request.resource.data;
        let ids = resource.data.get('unidadeIdsAntes', []);
        return papelDoAlvo() in ['bloqueado', 'professor']
          && resource.data.get('papelAntes', '') in papeisLider()
          && mentorDeAlguma(ids)
          && camposAlterados().hasOnly(['role', 'unidadeId', 'unidadeIds', 'papelAntes', 'unidadeIdsAntes', 'saidaEm'])
          && papelNovo() == resource.data.papelAntes
          && novo.get('unidadeIds', []) == ids && novo.get('unidadeId', '') == ids[0]
          && !('papelAntes' in novo) && !('unidadeIdsAntes' in novo) && !('saidaEm' in novo);
      }

      // Mentor só cria crachá de líder/unidade para as unidades DELE (aprovação de pedido de acesso).
      // Os convites do Google vêm PRIMEIRO: falham rápido para quase todo mundo e a regra tem limite de 1000 verificações.
      allow create: if liderTemporarioAceitaConvite(uid)
        || souAdmin()
        // Crachá de professor só nasce da APROVAÇÃO de um pedido (login do Google): nunca com e-mail e senha.
        || (logado() && meuPapel() == 'mentor' && papelNovo() == 'professor' && request.resource.data.get('loginGoogle', false) == true && semCobertura())
        || (logado() && meuPapel() == 'mentor' && papelNovo() in papeisLider()
            && ehMeuMentor(get(/databases/$(database)/documents/unidades/$(request.resource.data.unidadeId)).data.get('mentorId', ''))
            && request.resource.data.get('unidadeIds', [request.resource.data.unidadeId]) == [request.resource.data.unidadeId] && semCobertura())
        || (logado() && meuPapel() in papeisLider() && papelNovo() == 'professor' && request.resource.data.get('loginGoogle', false) == true && semCobertura())
        // Mentor novo convidado pelo admin (aba Mentores): no 1º acesso pelo Google, a própria pessoa cria
        // o crachá dela, SÓ se houver convite pendente para o e-mail Google dela e com os dados do convite.
        || mentorAceitaConvite(uid);

      // As condições "da própria pessoa" vêm PRIMEIRO (são baratas: começam comparando o login com o crachá).
      // O banco limita cada verificação a 1000 operações; esta regra é longa, então a ordem importa.
      allow update:
        // "Último acesso": a própria pessoa carimba só esse campo, com a hora do servidor (a aba Mentores mostra).
        if (request.auth.uid == uid && logado() && camposAlterados().hasOnly(['ultimoAcesso'])
            && request.resource.data.ultimoAcesso == request.time)
        // Depois de gravar o documento na gaveta privada, a PRÓPRIA pessoa só marca "documentoOk" no crachá
        // (o banco confere que o documento existe de verdade, na mesma gravação ou antes).
        || (request.auth.uid == uid && logado() && camposAlterados().hasOnly(['documentoOk'])
            && request.resource.data.documentoOk == true && existsAfter(caminhoDocumentoUsuario(uid)))
        // Atualização de cadastro (troca do login antigo pelo login pessoal do Google): a própria pessoa
        // atualiza SÓ os dados de contato, e só depois de conectar o Google à conta. O papel não muda,
        // exceto o login antigo "unidade", que vira "lider". Unidade, status e o resto ficam como estão.
        || (request.auth.uid == uid && logado()
            && 'google.com' in request.auth.token.firebase.identities
            && camposAlterados().hasOnly(['nome', 'telefone', 'email', 'emailAntigo', 'role', 'loginGoogle', 'cadastroAtualizadoEm', 'documentoOk', 'modalidades', 'tipoContrato', 'saverLocais'])
            && request.resource.data.get('modalidades', '') is string && request.resource.data.get('modalidades', '').size() <= 300
            && contratoValido(request.resource.data)
            && (!('documentoOk' in request.resource.data) || (request.resource.data.documentoOk == true && existsAfter(caminhoDocumentoUsuario(uid))))
            && request.resource.data.loginGoogle == true
            && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 80
            && request.resource.data.telefone is string && request.resource.data.telefone.size() >= 6 && request.resource.data.telefone.size() <= 30
            && (papelNovo() == papelDoAlvo() || (papelDoAlvo() == 'unidade' && papelNovo() == 'lider')))
        || souAdmin()
        // Líder temporário (só quando o alvo tem prazo: a checagem barata vem primeiro por causa do limite de 1000 verificações).
        || ('temporarioAte' in resource.data && logado() && meuPapel() == 'mentor' && mentorMexeNoTemporario())
        || (logado() && meuPapel() == 'mentor' && papelDoAlvo() in ['lider', 'unidade', 'professor']
            && camposAlterados().hasOnly(['nome', 'email', 'telefone']))
        || (logado() && meuPapel() in papeisLider() && papelDoAlvo() == 'professor'
            && camposAlterados().hasOnly(['nome', 'email']))
        // Mentor muda a liderança de UMA unidade DELE no crachá de alguém (aba Líderes; o admin já pode tudo acima).
        || (logado() && meuPapel() == 'mentor' && mentorMudaLideranca(uid))
        // Saída da função pela própria pessoa, e o mentor da unidade desfaz (ver saidaDaFuncao acima).
        || (logado() && saidaDaFuncao(uid))
        || (logado() && meuPapel() == 'mentor' && mentorDesfazSaida());

      allow delete: if souAdmin()
        // Professor do login antigo (sem Google): a própria pessoa apaga o crachá antigo para poder pedir acesso.
        || (autenticado() && request.auth.uid == uid && papelDoAlvo() == 'professor' && resource.data.get('loginGoogle', false) != true)
        || (logado() && meuPapel() == 'mentor' && papelDoAlvo() in papeisLider()
            && ehMeuMentor(get(/databases/$(database)/documents/unidades/$(resource.data.unidadeId)).data.get('mentorId', ''))
            && unidadesDoAlvo().size() <= 1);

      // Favoritos do Pratique Play: cada pessoa mexe só nos próprios.
      match /favoritos_play/{faixaId} {
        allow read, write: if logado() && request.auth.uid == uid;
      }
    }

    // ===================== PEDIDOS DE ACESSO (login pelo Google) =====================
    // Quem entra pelo Google pela 1ª vez ainda não tem crachá: ele só consegue criar/ver o PRÓPRIO pedido
    // (documento com o mesmo id do login). Admin vê todos; mentor vê os pedidos (a tela mostra só os das
    // unidades dele) e só aprova/recusa pedidos de LÍDER que tenham alguma unidade dele.
    // O pedido diz a função ("papel": lider ou mentor; pedido antigo sem o campo = lider) e até 5 unidades
    // ("unidadeIds"; a 1ª é sempre "unidadeId"). Pedido de MENTOR só o admin aprova.
    match /solicitacoes_acesso/{uid} {
      function souDono() { return autenticado() && request.auth.uid == uid; }
      function pedidoValido() {
        let d = request.resource.data;
        let ids = idsDoPedido(d);
        return d.keys().hasOnly(['nome', 'telefone', 'unidadeId', 'unidadeNome', 'email', 'status', 'criadoEm',
                                 'papel', 'unidadeIds', 'unidadeNomes', 'tambemProfessor', 'documentoOk', 'modalidades', 'tipoContrato', 'saverLocais'])
          && contratoValido(d)
          && d.get('documentoOk', true) == true
          && d.status == 'pendente'
          && d.email == request.auth.token.email
          && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 80
          && d.telefone is string && d.telefone.size() >= 6 && d.telefone.size() <= 30
          && d.get('papel', 'lider') in ['lider', 'mentor', 'professor']
          && (d.get('papel', 'lider') != 'professor' || (ids is list && ids.size() == 1))
          && d.get('modalidades', '') is string && d.get('modalidades', '').size() <= 300
          && d.get('tambemProfessor', false) is bool
          && d.get('unidadeNomes', []) is list && d.get('unidadeNomes', []).size() <= 5
          && ids is list && ids.size() >= 1 && ids.size() <= 5 && ids[0] == d.get('unidadeId', '')
          && d.unidadeId is string && exists(/databases/$(database)/documents/unidades/$(d.unidadeId));
      }

      allow read: if souDono() || souAdmin() || (logado() && meuPapel() == 'mentor')
        || (logado() && meuPapel() in papeisLider() && resource.data.papel == 'professor');

      // A própria pessoa faz (ou refaz, depois de recusado) o pedido, enquanto ainda não tem crachá.
      allow create, update: if souDono() && !temCracha() && pedidoValido();

      // Admin ou mentor de uma das unidades aprova/recusa (só os campos da análise).
      allow update: if (souAdmin() || mentorDoPedido(resource.data) || liderDoPedidoProfessor(resource.data))
        && camposAlterados().hasOnly(['status', 'motivo', 'analisadoPor', 'analisadoPorNome', 'analisadoEm'])
        && request.resource.data.status in ['aprovado', 'recusado'];

      allow delete: if souDono() || souAdmin() || mentorDoPedido(resource.data) || liderDoPedidoProfessor(resource.data);

    }

    // ===================== DOCUMENTO DE IDENTIFICAÇÃO (CPF / DNI / SSN) =====================
    // Gaveta privada do documento de quem tem crachá. Id = login da pessoa. Lê: a pessoa, o admin e o mentor
    // dos líderes das unidades dele. Grava: os mesmos (a pessoa corrige o próprio; o mentor corrige o dos líderes dele).
    match /documentos_privados/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || souAdmin() || mentorDoLider(uid);
      allow create, update: if documentoValido()
        && ((logado() && request.auth.uid == uid) || souAdmin() || mentorDoLider(uid));
      // Apagar: o admin, e o mentor do líder (ao excluir o cadastro do líder e liberar o documento).
      allow delete: if souAdmin() || mentorDoLider(uid);
    }

    // Documento informado no pedido de acesso (ainda sem crachá). Id = login da pessoa: ela grava; ela, o admin
    // e o mentor do pedido leem. Depois de aprovada, ela o copia para a gaveta do crachá (tela "Informar documento").
    match /documentos_do_pedido/{uid} {
      allow read: if (autenticado() && request.auth.uid == uid) || souAdmin()
        || (exists(/databases/$(database)/documents/solicitacoes_acesso/$(uid))
            && mentorDoPedido(get(/databases/$(database)/documents/solicitacoes_acesso/$(uid)).data));
      allow create, update: if autenticado() && request.auth.uid == uid && documentoValido();
      // O admin e o mentor do pedido também apagam (libera o documento quando o pedido é recusado ou excluído).
      allow delete: if (autenticado() && request.auth.uid == uid) || souAdmin() || mentorDoLider(uid)
        || (exists(/databases/$(database)/documents/solicitacoes_acesso/$(uid))
            && mentorDoPedido(get(/databases/$(database)/documents/solicitacoes_acesso/$(uid)).data));
    }

    // ===================== DOCUMENTOS ÚNICOS (um documento = uma pessoa) =====================
    // Reserva do documento: o código é "tipo_numero" e dentro só vai o login dono. Quem tentar gravar um
    // documento que já existe para OUTRA pessoa é recusado. O admin lê qualquer um (para achar cadastros); o mentor
    // só abre a reserva de quem é das unidades dele (líder com crachá ou pedido de acesso), uma por vez.
    match /documentos_unicos/{id} {
      // Pedido de acesso (ainda sem crachá) de uma unidade deste mentor.
      function mentorDoPedidoDe(alvo) {
        return exists(/databases/$(database)/documents/solicitacoes_acesso/$(alvo))
          && mentorDoPedido(get(/databases/$(database)/documents/solicitacoes_acesso/$(alvo)).data);
      }
      function podeMexerNoDe(alvo) {
        return (autenticado() && request.auth.uid == alvo) || souAdmin() || mentorDoLider(alvo);
      }
      function declaradoEm(caminho) {
        return existsAfter(caminho)
          && getAfter(caminho).data.numero == request.resource.data.numero
          && getAfter(caminho).data.tipo == request.resource.data.tipo;
      }
      allow read: if souAdmin();
      // Conferir UM documento digitado (sem listar): líder, mentor e admin descobrem de qual login ele é, para ligar
      // a pessoa à ficha da grade em vez de cadastrá-la de novo ("Adicionar professor").
      allow get: if gestorDeCadastro();
      allow create: if request.resource.data.keys().hasOnly(['uid', 'tipo', 'numero'])
        && request.resource.data.uid is string
        && documentoFormatoOk(request.resource.data)
        && id == request.resource.data.tipo + '_' + request.resource.data.numero
        && podeMexerNoDe(request.resource.data.uid)
        // o documento tem que estar declarado na gaveta privada (do crachá ou do pedido), na mesma gravação
        && (declaradoEm(caminhoDocumentoUsuario(request.resource.data.uid))
            || (request.auth.uid == request.resource.data.uid
                && declaradoEm(/databases/$(database)/documents/documentos_do_pedido/$(request.auth.uid))));
      // Reescrever igual (mesmo dono, mesmos dados) é aceito; trocar de dono, não.
      allow update: if request.resource.data == resource.data && podeMexerNoDe(resource.data.uid);
      allow delete: if podeMexerNoDe(resource.data.uid) || mentorDoPedidoDe(resource.data.uid);
    }

    // ===================== DOCUMENTO DA FICHA DA GRADE (professores/{id}) =====================
    // A ficha (professores) é lida por todo logado: o número NÃO vai nela, só "documentoOk".
    // Gaveta documentos_ficha/{professorId}: o número. Leem: admin e mentor. O líder só grava ficha que ainda não tem
    // documento (cadastro novo ou ficha antiga sendo completada); corrigir e apagar: admin e mentor.
    function gestorDeCadastro() { return logado() && meuPapel() in ['admin', 'administrador', 'master', 'mentor', 'lider', 'unidade']; }
    function adminOuMentor() { return souAdmin() || (logado() && meuPapel() == 'mentor'); }

    match /documentos_ficha/{professorId} {
      // A reserva do mesmo número, apontando para esta ficha, tem que existir ao final da mesma gravação.
      function reservadoParaEsta() {
        let d = request.resource.data;
        let reserva = /databases/$(database)/documents/documentos_professor/$(d.tipo + '_' + d.numero);
        return existsAfter(reserva) && getAfter(reserva).data.professorId == professorId;
      }
      allow read: if adminOuMentor();
      allow create: if documentoValido() && gestorDeCadastro() && reservadoParaEsta()
        && existsAfter(/databases/$(database)/documents/professores/$(professorId));
      allow update: if documentoValido() && adminOuMentor() && reservadoParaEsta();
      allow delete: if adminOuMentor();
    }

    // Reserva documentos_professor/{tipo_numero} = { professorId }: um documento = uma ficha (repetido é recusado).
    // Líder, mentor e admin CONFEREM um documento que digitaram (get); listar, só o admin.
    // Se o documento já é de alguém com login (documentos_unicos), só vale para a ficha ligada a esse mesmo login.
    match /documentos_professor/{id} {
      function reservaValida() {
        let d = request.resource.data;
        let ficha = /databases/$(database)/documents/documentos_ficha/$(d.professorId);
        let unico = /databases/$(database)/documents/documentos_unicos/$(id);
        return d.keys().hasOnly(['professorId', 'tipo', 'numero'])
          && d.professorId is string && documentoFormatoOk(d)
          && id == d.tipo + '_' + d.numero
          && existsAfter(ficha) && getAfter(ficha).data.numero == d.numero && getAfter(ficha).data.tipo == d.tipo
          && (!exists(unico)
              || get(unico).data.uid == getAfter(/databases/$(database)/documents/professores/$(d.professorId)).data.get('uidLogin', ''));
      }
      allow get: if gestorDeCadastro();
      allow list: if souAdmin();
      allow create: if gestorDeCadastro() && reservaValida();
      // Trocar de ficha só ao juntar fichas: só o admin (o mentor corrige apagando a reserva antiga e criando a nova).
      allow update: if souAdmin() && reservaValida();
      allow delete: if adminOuMentor();
    }

    // ===================== CONTATOS ÚNICOS (um e-mail / um telefone = uma pessoa) =====================
    // Reserva contatos_unicos/{email_x | tel_BR:xx} = { tipo, uid?, professorId? }: o dono é a pessoa (o crachá
    // e/ou a ficha da grade ligada a ele). A reserva de OUTRA pessoa não pode ser tomada.
    // F3 parte A: só a coleção nova; os cadastros ainda gravam sem exigir reserva (isso é a parte B).
    match /contatos_unicos/{id} {
      function caminhoFicha(pid) { return /databases/$(database)/documents/professores/$(pid); }
      // A ficha existe; com login junto, a ficha tem que estar ligada a esse login (uma consulta só por ficha:
      // o banco limita as consultas por gravação, e o botão do admin grava em lote).
      function fichaOk(d) {
        return !('professorId' in d)
          || (d.professorId is string && d.professorId.size() > 0
              && ('uid' in d
                  ? get(caminhoFicha(d.professorId)).data.get('uidLogin', '') == d.uid
                  : exists(caminhoFicha(d.professorId))));
      }
      function formatoOk(d) {
        return d.keys().hasOnly(['tipo', 'uid', 'professorId'])
          && ((d.tipo == 'email' && id.matches('^email_[^ @]+@[^ @]+$')) || (d.tipo == 'tel' && id.matches('^tel_[A-Z]{2}:[0-9]{8,10}$')))
          && ('uid' in d || 'professorId' in d)
          && (!('uid' in d) || (d.uid is string && d.uid.size() > 0))
          && fichaOk(d);
      }
      // Grava: líder, mentor e admin; ou a própria pessoa, só com o próprio login.
      function podeGravar(d) { return gestorDeCadastro() || (logado() && d.get('uid', '') == request.auth.uid); }
      function minha() { return autenticado() && resource.data.get('uid', '') == request.auth.uid; }
      // A da minha ficha (reserva só da ficha ligada ao meu login) também é minha.
      function daMinhaFicha() {
        return autenticado() && resource.data.get('professorId', '') != ''
          && get(caminhoFicha(resource.data.professorId)).data.get('uidLogin', '') == request.auth.uid;
      }
      // Parte B: antes de salvar, a tela confere se o dado está livre. Logado pode saber que NÃO existe reserva
      // (livre); a de outra pessoa continua fechada (a recusa = "já é de outra pessoa").
      allow get: if gestorDeCadastro() || (autenticado() && resource == null) || minha() || daMinhaFicha();
      allow list: if souAdmin();
      allow create: if podeGravar(request.resource.data) && formatoOk(request.resource.data);
      // Só a MESMA pessoa atualiza: mantém o login ou a ficha de antes (ex.: junta o login à ficha ligada).
      allow update: if podeGravar(request.resource.data) && formatoOk(request.resource.data)
        && request.resource.data.tipo == resource.data.tipo
        && ((resource.data.get('uid', '') != '' && request.resource.data.get('uid', '') == resource.data.get('uid', ''))
            || (resource.data.get('professorId', '') != '' && request.resource.data.get('professorId', '') == resource.data.get('professorId', '')));
      // Apagar a trava: admin, mentor ou a própria pessoa. Líder LER pode (é assim que o aviso de repetido aparece),
      // mas não apaga a reserva de quem é de outra unidade.
      allow delete: if souAdmin() || (logado() && meuPapel() == 'mentor') || minha();
    }

    // ===================== AVISOS DE SAÍDA (saidas_acesso) =====================
    // Quando alguém diz "não sou mais da unidade" / "não sou mais mentor", o acesso dele é desligado na hora
    // (ver saidaDaFuncao em usuarios) e este aviso aparece em Pendências: o mentor da unidade (ou o admin) pode
    // desfazer ou dar ciência. Aviso de MENTOR só o admin trata. Id do aviso = login da pessoa.
    match /saidas_acesso/{uid} {
      function mentorDoAviso(a) {
        return logado() && meuPapel() == 'mentor' && a.get('papel', 'lider') == 'lider'
          && a.get('unidadeIds', []) is list && a.get('unidadeIds', []).size() >= 1 && a.get('unidadeIds', []).size() <= 5
          && (mentorDaUnidadeId(a.unidadeIds[0])
            || (a.unidadeIds.size() > 1 && mentorDaUnidadeId(a.unidadeIds[1]))
            || (a.unidadeIds.size() > 2 && mentorDaUnidadeId(a.unidadeIds[2]))
            || (a.unidadeIds.size() > 3 && mentorDaUnidadeId(a.unidadeIds[3]))
            || (a.unidadeIds.size() > 4 && mentorDaUnidadeId(a.unidadeIds[4])));
      }
      function avisoValido() {
        let d = request.resource.data;
        let cracha = getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
        return request.auth.uid == uid
          && d.keys().hasOnly(['nome', 'email', 'telefone', 'papel', 'unidadeIds', 'unidadeNomes', 'continuaProfessor', 'status', 'criadoEm'])
          && d.status == 'pendente' && d.criadoEm == request.time
          && d.papel in ['lider', 'mentor']
          && d.nome is string && d.nome.size() <= 80 && d.email is string && d.telefone is string
          && d.get('continuaProfessor', false) is bool
          && d.get('unidadeNomes', []) is list && d.get('unidadeNomes', []).size() <= 30
          && d.get('unidadeIds', []) == cracha.get('unidadeIdsAntes', [])
          && cracha.get('saidaEm', null) == request.time
          && cracha.get('papelAntes', '') != '';
      }

      allow read: if souAdmin() || (logado() && meuPapel() == 'mentor');
      // A própria pessoa cria o aviso JUNTO com a saída dela (mesma gravação).
      allow create, update: if autenticado() && avisoValido();
      // Admin ou mentor da unidade trata o aviso (só os campos da análise).
      allow update: if (souAdmin() || mentorDoAviso(resource.data))
        && camposAlterados().hasOnly(['status', 'analisadoPor', 'analisadoPorNome', 'analisadoEm'])
        && request.resource.data.status in ['desfeita', 'ciente'];
    }

    // ===================== PEDIDOS DE OUTRA UNIDADE (pedidos_unidade) =====================
    // O líder (já com crachá) pede, na atualização de cadastro, para liderar mais uma unidade. Um documento por
    // unidade pedida (id = login + "_" + unidade), então cada mentor vê e resolve só os pedidos das unidades dele.
    // A própria pessoa cria; o mentor da unidade (ou o admin) aprova/recusa; aprovar também grava o crachá e a
    // unidade (regra mentorMudaLideranca em usuarios).
    match /pedidos_unidade/{pid} {
      function pedidoUnidadeValido() {
        let d = request.resource.data;
        let cracha = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
        let minhas = 'unidadeIds' in cracha ? cracha.unidadeIds : [cracha.get('unidadeId', '')];
        return logado() && cracha.get('role', '').lower() in papeisLider()
          && d.keys().hasOnly(['uid', 'nome', 'email', 'telefone', 'unidadeId', 'unidadeNome', 'unidadesAtuais', 'status', 'criadoEm'])
          && d.uid == request.auth.uid
          && d.unidadeId is string && d.unidadeId != ''
          && pid == request.auth.uid + '_' + d.unidadeId
          && !(d.unidadeId in minhas)
          && exists(/databases/$(database)/documents/unidades/$(d.unidadeId))
          && d.status == 'pendente' && d.criadoEm == request.time
          && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 80
          && d.telefone is string && d.telefone.size() >= 6 && d.telefone.size() <= 30
          && d.email is string && d.email.size() <= 120
          && d.get('unidadeNome', '') is string && d.get('unidadeNome', '').size() <= 120
          && d.get('unidadesAtuais', []) is list && d.get('unidadesAtuais', []).size() <= 30;
      }

      allow read: if logado() && (resource.data.uid == request.auth.uid || meuPapel() in ['admin', 'administrador', 'master', 'mentor']);
      // A própria pessoa faz (ou refaz, depois de recusado) o pedido.
      allow create: if pedidoUnidadeValido();
      allow update: if pedidoUnidadeValido() && resource.data.uid == request.auth.uid;
      // Admin ou mentor da unidade aprova/recusa (só os campos da análise).
      allow update: if resource.data.status == 'pendente'
        && (souAdmin() || (logado() && meuPapel() == 'mentor' && mentorDaUnidadeId(resource.data.unidadeId)))
        && camposAlterados().hasOnly(['status', 'motivo', 'analisadoPor', 'analisadoPorNome', 'analisadoEm'])
        && request.resource.data.status in ['aprovado', 'recusado'];
      allow delete: if logado() && (resource.data.uid == request.auth.uid || souAdmin()
        || (meuPapel() == 'mentor' && mentorDaUnidadeId(resource.data.unidadeId)));
    }

    // ===================== CONVITES DE MENTOR (cadastro pelo e-mail Google, sem senha) =====================
    // O admin cadastra o mentor novo pelo e-mail do Google: isso já É a aprovação. Quando a pessoa entra pelo
    // Google com esse e-mail, ela mesma cria o crachá (regra mentorAceitaConvite) e marca o convite como usado.
    // Só o admin vê, cria e cancela convites; a pessoa convidada vê só o dela. Nada é apagado: cancelar = status.
    match /convites_acesso/{email} {
      function souConvidado() { return emailGoogleVerificado() && request.auth.token.email.lower() == email; }

      // O mentor lê os convites de líder temporário dele (o convite guarda "mentorId" = escopo do mentor; consulta com where).
      allow read: if souAdmin() || souConvidado()
        || (logado() && meuPapel() == 'mentor' && resource.data.get('papel', '') == 'lider'
            && ehMeuMentor(resource.data.get('mentorId', '')));

      allow create, update: if souAdmin()
        && request.resource.data.papel == 'mentor'
        && request.resource.data.status in ['pendente', 'cancelado']
        && request.resource.data.email == email
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3
        && request.resource.data.telefone is string && request.resource.data.telefone.size() >= 6;

      // Convite de LÍDER TEMPORÁRIO: admin, ou mentor de TODAS as unidades do convite (até 5), prazo de no máximo 61 dias.
      function conviteTemporarioOk() {
        let d = request.resource.data;
        let ids = d.get('unidadeIds', []);
        return d.papel == 'lider' && d.status in ['pendente', 'cancelado']
          && d.email == email
          && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 80
          && d.telefone is string && d.telefone.size() >= 6 && d.telefone.size() <= 30
          && ids is list && ids.size() >= 1 && ids.size() <= 5 && d.get('unidadeId', '') == ids[0]
          && d.temporarioAte is timestamp && d.temporarioAte <= request.time + duration.value(3650, 'd')
          && (d.status == 'cancelado' || d.temporarioAte > request.time)
          && d.get('mentorId', '') is string;
      }
      allow create: if conviteTemporarioOk() && request.resource.data.criadoPor == request.auth.uid
        && (souAdmin() || (logado() && meuPapel() == 'mentor'
            && ehMeuMentor(request.resource.data.get('mentorId', ''))
            && mentorDeTodas(request.resource.data.get('unidadeIds', []))));
      allow update: if conviteTemporarioOk()
        && request.resource.data.criadoPor in [request.auth.uid, resource.data.get('criadoPor', '')]
        && (souAdmin() || (logado() && meuPapel() == 'mentor'
            && ehMeuMentor(request.resource.data.get('mentorId', ''))
            && resource.data.get('papel', '') == 'lider'
            && mentorDeTodas(resource.data.get('unidadeIds', []))
            && mentorDeTodas(request.resource.data.get('unidadeIds', []))));

      // A pessoa convidada só marca o PRÓPRIO convite como usado, junto com a criação do crachá dela.
      allow update: if souConvidado() && resource.data.status == 'pendente'
        && camposAlterados().hasOnly(['status', 'usadoPor', 'usadoEm'])
        && request.resource.data.status == 'usado'
        && request.resource.data.usadoPor == request.auth.uid
        && existsAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // ===================== FECHAMENTO DO MÊS (resumos_mensais) =====================
    // Resumo pronto das validações de cada mês já passado (Relatórios, Financeiro, Radar).
    // Logados leem; só o admin monta/refaz, para ninguém forjar números.
    match /resumos_mensais/{mes} {
      allow read: if logado();
      allow write: if souAdmin();
    }

    // ===================== TABELA DE PREÇOS (tabela_precos) =====================
    // Valor por aula por modalidade e pulseira (src/utils/tabelaPrecos.js). Admin, mentor e líder leem; PROFESSOR NÃO
    // lê (são valores de pagamento); só o admin grava. Está na lista de exceções da regra-curinga (senão ela liberaria).
    match /tabela_precos/{docId} {
      allow read: if logado() && (meuPapel() in ['admin', 'administrador', 'master', 'mentor'] || meuPapel() in papeisLider());
      allow write: if souAdmin();
    }

    // ===================== TELEMETRIA DE LEITURAS (telemetria_leituras) =====================
    // Resumo de quantas leituras cada pessoa fez no dia, por tela (src/services/telemetriaLeituras.js).
    // Cada pessoa grava só o próprio documento do dia ({AAAA-MM-DD}_{uid}), com a hora do servidor e só estes
    // campos; só o admin lê. Ninguém apaga.
    match /telemetria_leituras/{docId} {
      allow read: if souAdmin();
      allow create, update: if logado()
        && docId == request.resource.data.dia + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['dia', 'uid', 'papel', 'atualizadoEm', 'total', 'itens'])
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.total is int && request.resource.data.total >= 0
        && request.resource.data.itens is map && request.resource.data.itens.size() <= 120;
    }

    // ===================== CADASTRO DE WORKSHOPS (Cofre Master > Loja & Eventos > Workshops) =====================
    // workshops_cadastro/{id}: nome, modalidade, data (AAAA-MM-DD), local, status, titular (opcional).
    // Só admin e mentor leem e gravam. Workshop com participantes (totalParticipantes > 0) não pode ser apagado.
    function workshopCadastroOk(d) {
      return d.keys().hasOnly(['nome', 'modalidade', 'data', 'local', 'status', 'titularProfessorId', 'titularNome',
                               'totalParticipantes', 'duplicadoDe', 'criadoEm', 'criadoPor', 'atualizadoEm', 'atualizadoPor'])
        && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 150
        && d.modalidade in ['Jump', 'Power Dance', 'Power Training', 'Energy Jump', 'Power Core', 'Power Fight', 'Power Bumbum']
        && d.data is string && d.data.size() == 10
        && d.status in ['agendado', 'realizado', 'cancelado']
        && (!('local' in d) || (d.local is string && d.local.size() <= 150))
        && (!('titularNome' in d) || (d.titularNome is string && d.titularNome.size() <= 150))
        && (!('titularProfessorId' in d) || d.titularProfessorId is string)
        && (!('totalParticipantes' in d) || (d.totalParticipantes is int && d.totalParticipantes >= 0));
    }
    match /workshops_cadastro/{workshopId} {
      // O professor lê o cadastro (nome, data, modalidade) para escolher o workshop que fez em "Meus workshops".
      // Os participantes (subcoleção abaixo) continuam só do admin.
      allow read: if adminOuMentor() || souProfessor();
      allow create: if adminOuMentor() && workshopCadastroOk(request.resource.data)
        && (souAdmin() || request.resource.data.get('totalParticipantes', 0) == 0);
      // O contador de participantes quem muda é a importação (admin): o mentor não o altera.
      allow update: if adminOuMentor() && workshopCadastroOk(request.resource.data)
        && (souAdmin() || request.resource.data.get('totalParticipantes', 0) == resource.data.get('totalParticipantes', 0));
      allow delete: if adminOuMentor() && resource.data.get('totalParticipantes', 0) == 0;

      // Participantes (importados da plataforma de ingressos ou ligados na mão). Têm e-mail e telefone de gente que
      // pode nem ser professor: só o admin lê e grava.
      match /participantes/{participanteId} {
        function participanteOk(d) {
          return d.keys().hasOnly(['nome', 'email', 'telefone', 'telefone2', 'professorIds', 'status', 'origem',
                                   'criadoEm', 'criadoPor', 'atualizadoEm', 'atualizadoPor'])
            && d.nome is string && d.nome.size() <= 150
            && d.get('email', '') is string && d.get('email', '').size() <= 150
            && d.get('telefone', '') is string && d.get('telefone', '').size() <= 40
            && d.get('telefone2', '') is string && d.get('telefone2', '').size() <= 40
            && d.professorIds is list && d.professorIds.size() <= 12
            && d.status in ['ligado', 'sem-cadastro']
            && d.origem in ['importacao', 'manual'];
        }
        allow read: if souAdmin();
        allow create, update: if souAdmin() && participanteOk(request.resource.data);
        allow delete: if souAdmin();
      }
    }

    // Crachá antigo sem unidade: a unidade vem de um vínculo do próprio professor (vinculoId no certificado).
    // O vínculo precisa ser dele (professorId do crachá ou cadastro com uidLogin = este login) e da mesma unidade.
    function certVinculoDoProfessor(d, cracha, v) {
      return string(v.get('unidadeId', '')) == d.unidadeId
        && (v.get('professorId', '') == cracha.get('professorId', '#')
            || get(/databases/$(database)/documents/professores/$(v.get('professorId', '#'))).data.get('uidLogin', '') == request.auth.uid);
    }
    function certUnidadeOk(d, cracha) {
      return d.unidadeId == cracha.get('unidadeId', '')
        || (d.get('vinculoId', '') is string && d.get('vinculoId', '') != ''
            && exists(/databases/$(database)/documents/vinculos/$(d.vinculoId))
            && certVinculoDoProfessor(d, cracha, get(/databases/$(database)/documents/vinculos/$(d.vinculoId)).data));
    }

    // ===================== ATUALIZAÇÃO DE CONTRATO DO PROFESSOR (atualizacoes_professor) =====================
    // O professor pede a mudança de CLT/Saver (unidades e horários) em "Meu cadastro". Um pedido por login (id = login).
    // Lê: o dono, o admin, o mentor da unidade e o líder da unidade. Aprova ou recusa: esses três (menos o dono).
    // Aprovado, quem aprova grava o contrato na ficha (professores/{id}); o professor nunca grava a ficha.
    match /atualizacoes_professor/{uid} {
      function atuVerificador(unidadeId) {
        return souAdmin()
          || (logado() && meuPapel() == 'mentor' && mentorDaUnidadeId(unidadeId))
          || (logado() && meuPapel() in papeisLider() && unidadeId is string && unidadeId in unidadesDoLiderUid(request.auth.uid));
      }
      function atuValida() {
        let d = request.resource.data;
        let cracha = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
        return logado() && request.auth.uid == uid && cracha.get('role', '').lower() == 'professor'
          && d.keys().hasOnly(['uid', 'nome', 'unidadeId', 'vinculoId', 'tipoContrato', 'saverLocais', 'status', 'criadoEm'])
          && d.uid == request.auth.uid
          && d.status == 'pendente' && d.criadoEm == request.time
          && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 80
          && d.unidadeId is string && d.unidadeId != '' && certUnidadeOk(d, cracha)
          && d.tipoContrato in ['clt', 'saver']
          && d.saverLocais is list && d.saverLocais.size() <= 5
          && (d.tipoContrato == 'saver' ? d.saverLocais.size() >= 1 : d.saverLocais.size() == 0);
      }
      allow read: if (logado() && request.auth.uid == uid) || atuVerificador(resource.data.unidadeId);
      allow create: if atuValida();
      allow update: if atuValida() && resource.data.uid == request.auth.uid;
      allow update: if resource.data.status == 'pendente' && atuVerificador(resource.data.unidadeId)
        && camposAlterados().hasOnly(['status', 'motivo', 'analisadoPor', 'analisadoPorNome', 'analisadoEm'])
        && request.resource.data.status in ['aprovado', 'recusado'];
      allow delete: if (logado() && request.auth.uid == uid) || souAdmin();
    }

    // ===================== CERTIFICADOS DE WORKSHOP DO PROFESSOR (certificados_professor) =====================
    // O professor informa o workshop que fez, a data e a FOTO do certificado (JPEG já comprimido, em texto base64,
    // porque o plano gratuito não tem Storage). Um documento por certificado (id = login + "_" + código curto).
    // Lê: o dono, o admin, o mentor da unidade e o líder da unidade. Verifica/recusa: esses três (menos o dono).
    // A foto NUNCA vai para o crachá aberto nem para listas públicas.
    match /certificados_professor/{cid} {
      function certVerificador(unidadeId) {
        return souAdmin()
          || (logado() && meuPapel() == 'mentor' && mentorDaUnidadeId(unidadeId))
          || (logado() && meuPapel() in papeisLider() && unidadeId is string && unidadeId in unidadesDoLiderUid(request.auth.uid));
      }
      // O professor escolhe um workshop JÁ CADASTRADO: o id do certificado é login + "_" + id do workshop (não repete),
      // o workshop precisa existir, não estar cancelado, e nome/data são os do cadastro.
      function certWorkshopOk(d) {
        return d.get('workshopId', '') is string && d.get('workshopId', '') != ''
          && cid == request.auth.uid + '_' + d.workshopId
          && exists(/databases/$(database)/documents/workshops_cadastro/$(d.workshopId))
          && get(/databases/$(database)/documents/workshops_cadastro/$(d.workshopId)).data.status != 'cancelado'
          && get(/databases/$(database)/documents/workshops_cadastro/$(d.workshopId)).data.nome == d.workshop
          && get(/databases/$(database)/documents/workshops_cadastro/$(d.workshopId)).data.data == d.dataFeito
          && (!('modalidade' in d) || d.modalidade == get(/databases/$(database)/documents/workshops_cadastro/$(d.workshopId)).data.modalidade);
      }
      function certValido() {
        let d = request.resource.data;
        let cracha = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
        return logado() && cracha.get('role', '').lower() == 'professor'
          && d.keys().hasOnly(['uid', 'unidadeId', 'vinculoId', 'workshopId', 'modalidade', 'nome', 'workshop', 'dataFeito', 'foto', 'status', 'criadoEm'])
          && d.uid == request.auth.uid
          && cid.matches(request.auth.uid + '_[A-Za-z0-9]{4,24}')
          && d.unidadeId is string && d.unidadeId != '' && certUnidadeOk(d, cracha) && certWorkshopOk(d)
          && d.status == 'pendente' && d.criadoEm == request.time
          && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 80
          && d.workshop is string && d.workshop.size() >= 3 && d.workshop.size() <= 120
          && d.dataFeito is string && d.dataFeito.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && d.foto is string && d.foto.size() >= 200 && d.foto.size() <= 700000
          && d.foto.matches('data:image/jpeg;base64,.*');
      }

      allow read: if (logado() && resource.data.uid == request.auth.uid) || certVerificador(resource.data.unidadeId);
      // O dono envia; e pode corrigir/reenviar enquanto não foi verificado (recusado volta a pendente).
      allow create: if certValido();
      allow update: if certValido() && resource.data.uid == request.auth.uid && resource.data.status in ['pendente', 'recusado'];
      // Admin, mentor ou líder da unidade verifica ou recusa (só os campos da análise).
      allow update: if resource.data.status == 'pendente' && certVerificador(resource.data.unidadeId)
        && camposAlterados().hasOnly(['status', 'motivo', 'analisadoPor', 'analisadoPorNome', 'analisadoEm'])
        && request.resource.data.status in ['verificado', 'recusado'];
      // Apaga: o dono (se ainda não verificado) ou o admin.
      allow delete: if (logado() && resource.data.uid == request.auth.uid && resource.data.status != 'verificado') || souAdmin();
    }

    // ===================== AUDITORIA, FINANCEIRO, LOJA E PLAY (Etapa 3 das regras por unidade) =====================
    // Cada coleção abaixo tem regra própria e está na lista de exceções da regra-curinga lá embaixo.
    function souAdminOuMentor() { return logado() && meuPapel() in ['admin', 'administrador', 'master', 'mentor']; }

    // Registros de auditoria: todo mundo que está logado CRIA (inclusive professor, ao validar, e o log de sair do
    // sistema); lê quem está logado; ninguém edita nem apaga, só o admin.
    match /auditoria_cronograma/{id} {
      allow read: if logado();
      allow create: if logado();
      allow update, delete: if souAdmin();
    }
    match /auditoria_configuracoes/{id} {
      allow read: if logado();
      allow create: if logado();
      allow update, delete: if souAdmin();
    }
    // Financeiro (tela só de admin e mentor): leitura e gravação só deles. Auditoria financeira nunca se edita.
    match /auditoria_financeiro/{id} {
      allow read: if souAdminOuMentor();
      allow create: if souAdminOuMentor();
      allow update, delete: if souAdmin();
    }
    match /indicadores_mensais/{id} {
      allow read, create, update: if souAdminOuMentor();
      allow delete: if souAdmin();
    }
    // Loja e Workshops (estoque, eventos e transações; tela só de admin e mentor).
    match /unipower_stock/{id} {
      allow read, write: if souAdminOuMentor();
    }
    match /unipower_workshops/{id} {
      allow read, write: if souAdminOuMentor();
    }
    match /unipower_transacoes/{id} {
      allow read, write: if souAdminOuMentor();
    }
    // Faixas do Pratique Play: quem está logado ouve; só o admin cadastra e apaga.
    match /pratique_play_faixas/{id} {
      allow read: if logado();
      allow write: if souAdmin();
    }

    // ===================== DEMAIS COLEÇÕES =====================
    // Qualquer coleção SEM regra própria (acima): quem está logado lê (como antes) e SÓ O ADMIN grava (restaurar backup).
    // (No Firestore, se QUALQUER regra libera, a ação passa; por isso as coleções com regra própria precisam estar na
    // lista de exceções de leitura e de escrita aqui embaixo.)
    match /{colecao}/{resto=**} {
      allow read: if logado() && !(colecao in ['feriados_propostas', 'solicitacoes_acesso', 'convites_acesso', 'saidas_acesso', 'pedidos_unidade', 'documentos_privados', 'documentos_do_pedido', 'documentos_unicos', 'documentos_ficha', 'documentos_professor', 'contatos_unicos', 'telemetria_leituras', 'tabela_precos', 'workshops_cadastro', 'certificados_professor', 'atualizacoes_professor', 'indicadores_mensais', 'auditoria_financeiro', 'unipower_stock', 'unipower_workshops', 'unipower_transacoes']);
      allow write: if souAdmin() && !(colecao in ['feriados', 'feriados_propostas', 'usuarios', 'publico', 'validacoes', 'aulas', 'aulas_publicas', 'solicitacoes_acesso', 'convites_acesso', 'saidas_acesso', 'pedidos_unidade', 'resumos_mensais', 'documentos_privados', 'documentos_do_pedido', 'documentos_unicos', 'professores', 'documentos_ficha', 'documentos_professor', 'contatos_unicos', 'telemetria_leituras', 'tabela_precos', 'workshops_cadastro', 'certificados_professor', 'atualizacoes_professor', 'unidades', 'configuracoes', 'vinculos']);
    }
  }
}
