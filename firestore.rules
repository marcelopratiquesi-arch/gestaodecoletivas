rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== FUNÇÕES =====================
    // "Logado" = tem acesso ao sistema = tem CRACHÁ (usuarios/{uid}) e o crachá não está bloqueado.
    // Vale para TODO tipo de login (Google ou e-mail e senha): qualquer pessoa consegue criar uma conta
    // de login por fora das telas, então só estar autenticado não basta. Sem crachá (nunca aprovado,
    // líder removido, login antigo de unidade desligado) ou com papel "bloqueado" = não lê nem grava nada.
    // Custa 1 leitura por pedido ao banco (o Firebase cobra o crachá uma vez só por pedido, mesmo que a
    // regra o consulte mais de uma vez).
    function autenticado() { return request.auth != null; }
    function temCracha() { return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    // Mentor com status "inativo" (aba Mentores) também fica sem acesso. Sem leitura extra: é o mesmo crachá.
    function crachaAtivo(c) {
      return c.get('role', '').lower() != 'bloqueado'
        && !(c.get('role', '').lower() == 'mentor' && c.get('status', '') == 'inativo');
    }
    function logado() {
      return autenticado() && temCracha()
        && crachaAtivo(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data);
    }

    // Papel de quem está fazendo a ação, lido do crachá (usuarios/{uid}).
    // Custa 1 leitura, e só é usado ao GRAVAR em usuarios (nunca nas leituras do dia a dia).
    function meuPapel() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('role', '').lower();
    }
    function souAdmin() { return logado() && meuPapel() in ['admin', 'administrador', 'master']; }
    // Líder = perfil novo "lider" ou o antigo "unidade" (valem igual durante a transição).
    function papeisLider() { return ['lider', 'unidade']; }
    // Professor não grava cadastros (aulas, unidades, professores, modalidades, feriados...).
    // Quem não tem crachá em usuarios segue como antes (não é tratado como professor).
    function souProfessor() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && meuPapel() == 'professor';
    }
    // O mentor logado é o mentor desta unidade? (id vazio = não)
    function mentorDaUnidadeId(unidadeId) {
      return unidadeId is string && unidadeId != ''
        && get(/databases/$(database)/documents/unidades/$(unidadeId)).data.get('mentorId', '') == request.auth.uid;
    }
    function papelDoAlvo() { return resource.data.get('role', '').lower(); }
    function papelNovo() { return request.resource.data.get('role', '').lower(); }
    function camposAlterados() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Convite de mentor (convites_acesso/{e-mail Google}): só o admin cria. Vale para quem entrou AGORA
    // pelo Google com esse e-mail (verificado pelo Google).
    function emailGoogleVerificado() {
      return autenticado()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string && request.auth.token.email.size() > 3;
    }
    function caminhoConvite() { return /databases/$(database)/documents/convites_acesso/$(request.auth.token.email.lower()); }
    function mentorAceitaConvite(uid) {
      let d = request.resource.data;
      let c = get(caminhoConvite()).data;
      return emailGoogleVerificado() && request.auth.uid == uid
        && exists(caminhoConvite())
        && c.status == 'pendente' && c.papel == 'mentor'
        && d.keys().hasOnly(['nome', 'email', 'telefone', 'pais', 'role', 'status', 'loginGoogle', 'criadoPor', 'criadoEm'])
        && d.role == 'mentor' && d.status == 'ativo' && d.loginGoogle == true
        && d.email == request.auth.token.email.lower()
        && d.nome == c.nome && d.telefone == c.telefone && d.get('pais', '') == c.get('pais', '')
        && d.criadoPor == c.criadoPor
        // O convite precisa ser marcado como usado na MESMA gravação (não serve duas vezes).
        && getAfter(caminhoConvite()).data.status == 'usado';
    }

    // ===================== PÁGINA PÚBLICA DE HORÁRIOS =====================
    // Sem login, a página de horários lê só: a "vitrine" (nome/endereço das unidades e nome dos
    // professores), as aulas e as modalidades. Os cadastros completos de unidades e professores
    // (com e-mail, telefone e login) exigem login.
    match /publico/{docId} {
      allow read: if true;
      allow write: if logado() && meuPapel() in ['admin', 'administrador', 'master', 'mentor', 'lider', 'unidade'];
    }
    match /aulas/{document=**} {
      allow read: if true;
      allow write: if logado() && !souProfessor();
    }
    match /modalidades/{document=**} {
      allow read: if true;
      allow write: if logado() && !souProfessor();
    }
    match /unidades/{document=**} {
      allow read: if logado();
      allow write: if logado() && !souProfessor();
    }
    match /professores/{document=**} {
      allow read: if logado();
      allow write: if logado() && !souProfessor();
    }

    // ===================== VALIDAÇÕES (presença e pagamento) =====================
    // Mesma regra de prazo da tela (src/utils/validacoes.js):
    // - professor: só aulas em que é TITULAR, do mês atual até hoje; não muda o valor da aula,
    //   não lança aulão, não mexe em aula cancelada e não apaga nada;
    // - líder (unidade): só a própria unidade, até 60 dias para trás; mês já fechado exige justificativa;
    // - mentor: só as unidades dele; mês já fechado exige justificativa;
    // - admin: tudo (inclusive restaurar backup).
    // Datas no fuso do Brasil/Argentina (UTC-3).
    function agoraLocal() { return request.time - duration.value(3, 'h'); }
    function hojeLocal() { let a = agoraLocal(); return timestamp.date(a.year(), a.month(), a.day()); }
    function inicioDoMes() { let a = agoraLocal(); return timestamp.date(a.year(), a.month(), 1); }
    function diaDa(dataStr) {
      let p = dataStr.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    function meuUsuario() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function aulaDa(aulaId) { return get(/databases/$(database)/documents/aulas/$(aulaId)).data; }

    function dataValida(d) { return d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function justificada(d) { return d.get('justificativa', '') is string && d.get('justificativa', '').size() >= 10; }
    // Alunos: inteiro de 0 a 150 nas aulas da grade (aulão fica livre). Não mexer no número antigo também passa.
    function alunosOk(d) {
      return !('alunos' in d) || d.get('isAulao', false) == true
        || (d.alunos is int && d.alunos >= 0 && d.alunos <= 150)
        || (resource != null && resource.data.get('alunos', null) == d.alunos);
    }
    // Valor da aula: o mesmo do cronograma ou o que já estava gravado (valor da época).
    function valorOk(d, aula) {
      return d.get('valorEfetivo', 0) == aula.get('valor', 0)
        || (aula.get('valor', 0) is string && float(aula.valor) == d.get('valorEfetivo', 0))
        || (resource != null && d.get('valorEfetivo', 0) == resource.data.get('valorEfetivo', -1));
    }
    // Na criação, o documento da aula da grade tem ID fixo "<aulaId>_<data>".
    function idCerto(vid, d) { return resource != null || d.get('isAulao', false) == true || vid == d.aulaId + '_' + d.data; }
    // Na edição não se troca a aula nem o dia.
    function mesmaAulaEDia(d) {
      return resource == null || (resource.data.get('aulaId', null) == d.get('aulaId', null) && resource.data.data == d.data);
    }

    function souTitularDa(aula) {
      return aula.get('professorId', '') != ''
        && (meuUsuario().get('professorId', '') == aula.professorId
            || get(/databases/$(database)/documents/professores/$(aula.professorId)).data.get('uidLogin', '') == request.auth.uid);
    }

    function professorPodeGravar(vid, d) {
      let aula = aulaDa(d.aulaId);
      return meuPapel() == 'professor'
        && d.get('isAulao', false) != true
        && idCerto(vid, d) && mesmaAulaEDia(d)
        && diaDa(d.data) >= inicioDoMes() && diaDa(d.data) <= hojeLocal()
        && souTitularDa(aula)
        && d.unidadeId == aula.unidadeId
        && d.status in ['realizada', 'cancelada']
        && (d.get('substituicao', false) == true
              ? d.get('professorOriginalId', '') == aula.professorId
              : d.professorId == aula.professorId)
        && valorOk(d, aula)
        && (resource == null || resource.data.get('status', '') != 'cancelada');
    }

    function liderPodeGravar(vid, d) {
      return meuPapel() in papeisLider()
        && (d.unidadeId == meuUsuario().get('unidadeId', '') || d.unidadeId in meuUsuario().get('unidadeIds', []))
        && idCerto(vid, d) && mesmaAulaEDia(d)
        && diaDa(d.data) <= hojeLocal()
        && diaDa(d.data) >= hojeLocal() - duration.value(60, 'd')
        && (diaDa(d.data) >= inicioDoMes() || justificada(d))
        && (d.get('isAulao', false) == true || aulaDa(d.aulaId).unidadeId == d.unidadeId)
        && (d.get('isAulao', false) == true || valorOk(d, aulaDa(d.aulaId)));
    }

    function mentorPodeGravar(vid, d) {
      return meuPapel() == 'mentor'
        && get(/databases/$(database)/documents/unidades/$(d.unidadeId)).data.get('mentorId', '') == request.auth.uid
        && idCerto(vid, d) && mesmaAulaEDia(d)
        && (diaDa(d.data) >= inicioDoMes() || justificada(d));
    }

    function podeGravarValidacao(vid) {
      let d = request.resource.data;
      return souAdmin()
        || (logado() && dataValida(d) && d.get('validadoPor', '') == request.auth.uid && alunosOk(d)
            && (professorPodeGravar(vid, d) || liderPodeGravar(vid, d) || mentorPodeGravar(vid, d)));
    }

    match /validacoes/{vid} {
      allow read: if logado();
      allow create, update: if podeGravarValidacao(vid);
      // Apagar = "reverter cancelamento" (só admin e mentor da unidade, como na tela).
      allow delete: if souAdmin()
        || (logado() && meuPapel() == 'mentor'
            && get(/databases/$(database)/documents/unidades/$(resource.data.unidadeId)).data.get('mentorId', '') == request.auth.uid);
    }

    // ===================== CRACHÁS (usuarios) =====================
    // Ninguém muda o próprio papel nem se promove. Espelha o que as telas já fazem:
    // - admin: tudo (Mentores, Controle de Acessos, correções)
    // - mentor: cria/edita logins de líder e de professor; exclui login de líder (ao excluir a unidade)
    // - líder (lider/unidade): cria/edita logins de professor
    match /usuarios/{uid} {
      // Cada um sempre pode ler o próprio crachá (quem entrou pelo Google descobre se já foi aprovado).
      allow read: if logado() || (autenticado() && request.auth.uid == uid);

      // ---------- Liderança de várias unidades ----------
      // O crachá do líder guarda a unidade principal em "unidadeId" e TODAS as que ele comanda em "unidadeIds"
      // (a principal é sempre a 1ª da lista). Crachá antigo só tem "unidadeId". Uma unidade pode ter 2 líderes.
      function unidadesDoAlvo() {
        return !(papelDoAlvo() in papeisLider()) ? []
          : ('unidadeIds' in resource.data ? resource.data.unidadeIds
            : (resource.data.get('unidadeId', '') == '' ? [] : [resource.data.unidadeId]));
      }
      // O vínculo com o cadastro de professor é verdadeiro: professores/{professorId}.uidLogin == este login.
      function vinculoDeProfessorOk(uid) {
        return request.resource.data.get('professorId', '') is string
          && request.resource.data.get('professorId', '') != ''
          && get(/databases/$(database)/documents/professores/$(request.resource.data.professorId)).data.get('uidLogin', '') == uid;
      }
      // O mentor mexe em UMA unidade por vez ("unidadeAlterada"), e só numa unidade DELE:
      //  - entra: professor ou líder (de outra unidade, mesmo de outro mentor) passa a ser líder também desta;
      //  - sai, mas continua líder das outras unidades;
      //  - sai da única unidade: o líder que também é professor volta a ser professor.
      // A lista nova tem que ser exatamente a antiga mais (ou menos) essa unidade; nenhum outro campo muda.
      function mentorMudaLideranca(uid) {
        let novo = request.resource.data;
        let x = novo.get('unidadeAlterada', '');
        let antes = unidadesDoAlvo();
        let depois = novo.get('unidadeIds', []);
        return camposAlterados().hasOnly(['role', 'unidadeId', 'unidadeIds', 'professorId', 'unidadeAlterada'])
          && mentorDaUnidadeId(x)
          && (
            (!(x in antes) && depois == antes.concat([x])
              && papelNovo() == 'lider' && novo.get('unidadeId', '') == depois[0]
              && ((papelDoAlvo() in papeisLider() && novo.get('professorId', '') == resource.data.get('professorId', ''))
                  || (papelDoAlvo() == 'professor' && vinculoDeProfessorOk(uid))))
            || (x in antes && depois == antes.removeAll([x]) && depois.size() > 0
              && papelNovo() == papelDoAlvo() && novo.get('unidadeId', '') == depois[0]
              && novo.get('professorId', '') == resource.data.get('professorId', ''))
            || (antes == [x] && papelNovo() == 'professor' && vinculoDeProfessorOk(uid)
              && !('unidadeId' in novo) && !('unidadeIds' in novo))
          );
      }

      // ---------- Saída da função ("não sou mais da unidade" / "não sou mais mentor") ----------
      // A PRÓPRIA pessoa se tira do acesso, na hora, sem apagar o crachá (para dar para desfazer):
      //  - líder: vira 'bloqueado', ou volta a ser 'professor' se também é professor (perde só a liderança);
      //  - mentor: fica com status 'inativo' (já é sem acesso, ver crachaAtivo).
      // O crachá guarda de onde ela saiu (papelAntes, unidadeIdsAntes, saidaEm) e o aviso fica em saidas_acesso.
      function saidaDaFuncao(uid) {
        let novo = request.resource.data;
        let antes = unidadesDoAlvo();
        return request.auth.uid == uid
          && novo.get('saidaEm', null) == request.time
          && novo.get('papelAntes', '') == papelDoAlvo()
          && (
            (papelDoAlvo() in papeisLider() && papelNovo() == 'bloqueado'
              && camposAlterados().hasOnly(['role', 'papelAntes', 'unidadeIdsAntes', 'saidaEm'])
              && novo.get('unidadeIdsAntes', []) == antes)
            || (papelDoAlvo() in papeisLider() && papelNovo() == 'professor' && vinculoDeProfessorOk(uid)
              && camposAlterados().hasOnly(['role', 'unidadeId', 'unidadeIds', 'professorId', 'papelAntes', 'unidadeIdsAntes', 'saidaEm'])
              && novo.get('unidadeIdsAntes', []) == antes
              && !('unidadeId' in novo) && !('unidadeIds' in novo))
            || (papelDoAlvo() == 'mentor' && papelNovo() == 'mentor' && novo.get('status', '') == 'inativo'
              && camposAlterados().hasOnly(['status', 'papelAntes', 'saidaEm']))
          );
      }
      // Mentor de alguma das unidades (até 5) de uma lista.
      function mentorDeAlguma(ids) {
        return ids is list && ids.size() >= 1 && ids.size() <= 5
          && (mentorDaUnidadeId(ids[0])
            || (ids.size() > 1 && mentorDaUnidadeId(ids[1]))
            || (ids.size() > 2 && mentorDaUnidadeId(ids[2]))
            || (ids.size() > 3 && mentorDaUnidadeId(ids[3]))
            || (ids.size() > 4 && mentorDaUnidadeId(ids[4])));
      }
      // Desfazer a saída de um LÍDER (mentor de uma das unidades dele): volta a função e as unidades de antes.
      function mentorDesfazSaida() {
        let novo = request.resource.data;
        let ids = resource.data.get('unidadeIdsAntes', []);
        return papelDoAlvo() in ['bloqueado', 'professor']
          && resource.data.get('papelAntes', '') in papeisLider()
          && mentorDeAlguma(ids)
          && camposAlterados().hasOnly(['role', 'unidadeId', 'unidadeIds', 'papelAntes', 'unidadeIdsAntes', 'saidaEm'])
          && papelNovo() == resource.data.papelAntes
          && novo.get('unidadeIds', []) == ids && novo.get('unidadeId', '') == ids[0]
          && !('papelAntes' in novo) && !('unidadeIdsAntes' in novo) && !('saidaEm' in novo);
      }

      // Mentor só cria crachá de líder/unidade para as unidades DELE (aprovação de pedido de acesso).
      allow create: if souAdmin()
        || (logado() && meuPapel() == 'mentor' && papelNovo() == 'professor')
        || (logado() && meuPapel() == 'mentor' && papelNovo() in papeisLider()
            && get(/databases/$(database)/documents/unidades/$(request.resource.data.unidadeId)).data.get('mentorId', '') == request.auth.uid
            && request.resource.data.get('unidadeIds', [request.resource.data.unidadeId]) == [request.resource.data.unidadeId])
        || (logado() && meuPapel() in papeisLider() && papelNovo() == 'professor')
        // Mentor novo convidado pelo admin (aba Mentores): no 1º acesso pelo Google, a própria pessoa cria
        // o crachá dela, SÓ se houver convite pendente para o e-mail Google dela e com os dados do convite.
        || mentorAceitaConvite(uid);

      allow update: if souAdmin()
        || (logado() && meuPapel() == 'mentor' && papelDoAlvo() in ['lider', 'unidade', 'professor']
            && camposAlterados().hasOnly(['nome', 'email', 'telefone']))
        || (logado() && meuPapel() in papeisLider() && papelDoAlvo() == 'professor'
            && camposAlterados().hasOnly(['nome', 'email']))
        // Mentor muda a liderança de UMA unidade DELE no crachá de alguém (aba Líderes; o admin já pode tudo acima).
        || (logado() && meuPapel() == 'mentor' && mentorMudaLideranca(uid))
        // Saída da função pela própria pessoa, e o mentor da unidade desfaz (ver saidaDaFuncao acima).
        || (logado() && saidaDaFuncao(uid))
        || (logado() && meuPapel() == 'mentor' && mentorDesfazSaida())
        // Atualização de cadastro (troca do login antigo pelo login pessoal do Google): a própria pessoa
        // atualiza SÓ os dados de contato, e só depois de conectar o Google à conta. O papel não muda,
        // exceto o login antigo "unidade", que vira "lider". Unidade, status e o resto ficam como estão.
        || (logado() && request.auth.uid == uid
            && 'google.com' in request.auth.token.firebase.identities
            && camposAlterados().hasOnly(['nome', 'telefone', 'email', 'emailAntigo', 'role', 'loginGoogle', 'cadastroAtualizadoEm'])
            && request.resource.data.loginGoogle == true
            && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 80
            && request.resource.data.telefone is string && request.resource.data.telefone.size() >= 6 && request.resource.data.telefone.size() <= 30
            && (papelNovo() == papelDoAlvo() || (papelDoAlvo() == 'unidade' && papelNovo() == 'lider')));

      allow delete: if souAdmin()
        || (logado() && meuPapel() == 'mentor' && papelDoAlvo() in papeisLider()
            && get(/databases/$(database)/documents/unidades/$(resource.data.unidadeId)).data.get('mentorId', '') == request.auth.uid
            && unidadesDoAlvo().size() <= 1);

      // Favoritos do Pratique Play: cada pessoa mexe só nos próprios.
      match /favoritos_play/{faixaId} {
        allow read, write: if logado() && request.auth.uid == uid;
      }
    }

    // ===================== PEDIDOS DE ACESSO (login pelo Google) =====================
    // Quem entra pelo Google pela 1ª vez ainda não tem crachá: ele só consegue criar/ver o PRÓPRIO pedido
    // (documento com o mesmo id do login). Admin vê todos; mentor vê os pedidos (a tela mostra só os das
    // unidades dele) e só aprova/recusa pedidos de LÍDER que tenham alguma unidade dele.
    // O pedido diz a função ("papel": lider ou mentor; pedido antigo sem o campo = lider) e até 5 unidades
    // ("unidadeIds"; a 1ª é sempre "unidadeId"). Pedido de MENTOR só o admin aprova.
    match /solicitacoes_acesso/{uid} {
      function souDono() { return autenticado() && request.auth.uid == uid; }
      function idsDoPedido(p) { return p.get('unidadeIds', [p.get('unidadeId', '')]); }
      // Mentor de alguma das unidades (até 5) de um pedido de líder.
      function mentorDoPedido(p) {
        let ids = idsDoPedido(p);
        return logado() && meuPapel() == 'mentor' && p.get('papel', 'lider') == 'lider'
          && ids is list && ids.size() >= 1
          && (mentorDaUnidadeId(ids[0])
            || (ids.size() > 1 && mentorDaUnidadeId(ids[1]))
            || (ids.size() > 2 && mentorDaUnidadeId(ids[2]))
            || (ids.size() > 3 && mentorDaUnidadeId(ids[3]))
            || (ids.size() > 4 && mentorDaUnidadeId(ids[4])));
      }
      function pedidoValido() {
        let d = request.resource.data;
        let ids = idsDoPedido(d);
        return d.keys().hasOnly(['nome', 'telefone', 'unidadeId', 'unidadeNome', 'email', 'status', 'criadoEm',
                                 'papel', 'unidadeIds', 'unidadeNomes', 'tambemProfessor'])
          && d.status == 'pendente'
          && d.email == request.auth.token.email
          && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 80
          && d.telefone is string && d.telefone.size() >= 6 && d.telefone.size() <= 30
          && d.get('papel', 'lider') in ['lider', 'mentor']
          && d.get('tambemProfessor', false) is bool
          && d.get('unidadeNomes', []) is list && d.get('unidadeNomes', []).size() <= 5
          && ids is list && ids.size() >= 1 && ids.size() <= 5 && ids[0] == d.get('unidadeId', '')
          && d.unidadeId is string && exists(/databases/$(database)/documents/unidades/$(d.unidadeId));
      }

      allow read: if souDono() || souAdmin() || (logado() && meuPapel() == 'mentor');

      // A própria pessoa faz (ou refaz, depois de recusado) o pedido, enquanto ainda não tem crachá.
      allow create, update: if souDono() && !temCracha() && pedidoValido();

      // Admin ou mentor de uma das unidades aprova/recusa (só os campos da análise).
      allow update: if (souAdmin() || mentorDoPedido(resource.data))
        && camposAlterados().hasOnly(['status', 'motivo', 'analisadoPor', 'analisadoPorNome', 'analisadoEm'])
        && request.resource.data.status in ['aprovado', 'recusado'];

      allow delete: if souDono() || souAdmin() || mentorDoPedido(resource.data);
    }

    // ===================== AVISOS DE SAÍDA (saidas_acesso) =====================
    // Quando alguém diz "não sou mais da unidade" / "não sou mais mentor", o acesso dele é desligado na hora
    // (ver saidaDaFuncao em usuarios) e este aviso aparece em Pendências: o mentor da unidade (ou o admin) pode
    // desfazer ou dar ciência. Aviso de MENTOR só o admin trata. Id do aviso = login da pessoa.
    match /saidas_acesso/{uid} {
      function mentorDoAviso(a) {
        return logado() && meuPapel() == 'mentor' && a.get('papel', 'lider') == 'lider'
          && a.get('unidadeIds', []) is list && a.get('unidadeIds', []).size() >= 1 && a.get('unidadeIds', []).size() <= 5
          && (mentorDaUnidadeId(a.unidadeIds[0])
            || (a.unidadeIds.size() > 1 && mentorDaUnidadeId(a.unidadeIds[1]))
            || (a.unidadeIds.size() > 2 && mentorDaUnidadeId(a.unidadeIds[2]))
            || (a.unidadeIds.size() > 3 && mentorDaUnidadeId(a.unidadeIds[3]))
            || (a.unidadeIds.size() > 4 && mentorDaUnidadeId(a.unidadeIds[4])));
      }
      function avisoValido() {
        let d = request.resource.data;
        let cracha = getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
        return request.auth.uid == uid
          && d.keys().hasOnly(['nome', 'email', 'telefone', 'papel', 'unidadeIds', 'unidadeNomes', 'continuaProfessor', 'status', 'criadoEm'])
          && d.status == 'pendente' && d.criadoEm == request.time
          && d.papel in ['lider', 'mentor']
          && d.nome is string && d.nome.size() <= 80 && d.email is string && d.telefone is string
          && d.get('continuaProfessor', false) is bool
          && d.get('unidadeNomes', []) is list && d.get('unidadeNomes', []).size() <= 30
          && d.get('unidadeIds', []) == cracha.get('unidadeIdsAntes', [])
          && cracha.get('saidaEm', null) == request.time
          && cracha.get('papelAntes', '') != '';
      }

      allow read: if souAdmin() || (logado() && meuPapel() == 'mentor');
      // A própria pessoa cria o aviso JUNTO com a saída dela (mesma gravação).
      allow create, update: if autenticado() && avisoValido();
      // Admin ou mentor da unidade trata o aviso (só os campos da análise).
      allow update: if (souAdmin() || mentorDoAviso(resource.data))
        && camposAlterados().hasOnly(['status', 'analisadoPor', 'analisadoPorNome', 'analisadoEm'])
        && request.resource.data.status in ['desfeita', 'ciente'];
    }

    // ===================== PEDIDOS DE OUTRA UNIDADE (pedidos_unidade) =====================
    // O líder (já com crachá) pede, na atualização de cadastro, para liderar mais uma unidade. Um documento por
    // unidade pedida (id = login + "_" + unidade), então cada mentor vê e resolve só os pedidos das unidades dele.
    // A própria pessoa cria; o mentor da unidade (ou o admin) aprova/recusa; aprovar também grava o crachá e a
    // unidade (regra mentorMudaLideranca em usuarios).
    match /pedidos_unidade/{pid} {
      function pedidoUnidadeValido() {
        let d = request.resource.data;
        let cracha = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
        let minhas = 'unidadeIds' in cracha ? cracha.unidadeIds : [cracha.get('unidadeId', '')];
        return logado() && cracha.get('role', '').lower() in papeisLider()
          && d.keys().hasOnly(['uid', 'nome', 'email', 'telefone', 'unidadeId', 'unidadeNome', 'unidadesAtuais', 'status', 'criadoEm'])
          && d.uid == request.auth.uid
          && d.unidadeId is string && d.unidadeId != ''
          && pid == request.auth.uid + '_' + d.unidadeId
          && !(d.unidadeId in minhas)
          && exists(/databases/$(database)/documents/unidades/$(d.unidadeId))
          && d.status == 'pendente' && d.criadoEm == request.time
          && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 80
          && d.telefone is string && d.telefone.size() >= 6 && d.telefone.size() <= 30
          && d.email is string && d.email.size() <= 120
          && d.get('unidadeNome', '') is string && d.get('unidadeNome', '').size() <= 120
          && d.get('unidadesAtuais', []) is list && d.get('unidadesAtuais', []).size() <= 30;
      }

      allow read: if logado() && (resource.data.uid == request.auth.uid || meuPapel() in ['admin', 'administrador', 'master', 'mentor']);
      // A própria pessoa faz (ou refaz, depois de recusado) o pedido.
      allow create: if pedidoUnidadeValido();
      allow update: if pedidoUnidadeValido() && resource.data.uid == request.auth.uid;
      // Admin ou mentor da unidade aprova/recusa (só os campos da análise).
      allow update: if resource.data.status == 'pendente'
        && (souAdmin() || (logado() && meuPapel() == 'mentor' && mentorDaUnidadeId(resource.data.unidadeId)))
        && camposAlterados().hasOnly(['status', 'motivo', 'analisadoPor', 'analisadoPorNome', 'analisadoEm'])
        && request.resource.data.status in ['aprovado', 'recusado'];
      allow delete: if logado() && (resource.data.uid == request.auth.uid || souAdmin()
        || (meuPapel() == 'mentor' && mentorDaUnidadeId(resource.data.unidadeId)));
    }

    // ===================== CONVITES DE MENTOR (cadastro pelo e-mail Google, sem senha) =====================
    // O admin cadastra o mentor novo pelo e-mail do Google: isso já É a aprovação. Quando a pessoa entra pelo
    // Google com esse e-mail, ela mesma cria o crachá (regra mentorAceitaConvite) e marca o convite como usado.
    // Só o admin vê, cria e cancela convites; a pessoa convidada vê só o dela. Nada é apagado: cancelar = status.
    match /convites_acesso/{email} {
      function souConvidado() { return emailGoogleVerificado() && request.auth.token.email.lower() == email; }

      allow read: if souAdmin() || souConvidado();

      allow create, update: if souAdmin()
        && request.resource.data.papel == 'mentor'
        && request.resource.data.status in ['pendente', 'cancelado']
        && request.resource.data.email == email
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3
        && request.resource.data.telefone is string && request.resource.data.telefone.size() >= 6;

      // A pessoa convidada só marca o PRÓPRIO convite como usado, junto com a criação do crachá dela.
      allow update: if souConvidado() && resource.data.status == 'pendente'
        && camposAlterados().hasOnly(['status', 'usadoPor', 'usadoEm'])
        && request.resource.data.status == 'usado'
        && request.resource.data.usadoPor == request.auth.uid
        && existsAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // ===================== FECHAMENTO DO MÊS (resumos_mensais) =====================
    // Resumo pronto das validações de cada mês já passado (Relatórios, Financeiro, Radar).
    // Logados leem; só o admin monta/refaz, para ninguém forjar números.
    match /resumos_mensais/{mes} {
      allow read: if logado();
      allow write: if souAdmin();
    }

    // ===================== DEMAIS COLEÇÕES =====================
    // Logados leem e escrevem (como antes), EXCETO as coleções com regra própria acima
    // (usuarios, publico, validacoes, solicitacoes_acesso, convites_acesso e resumos_mensais).
    // Professor não grava nada aqui, só cria registros de auditoria (log da validação e do "Sair").
    // (No Firestore, se QUALQUER regra libera, a ação passa; por isso as exceções precisam estar aqui.)
    match /{colecao}/{resto=**} {
      allow read: if logado() && !(colecao in ['solicitacoes_acesso', 'convites_acesso', 'saidas_acesso', 'pedidos_unidade']);
      allow write: if logado() && !(colecao in ['usuarios', 'publico', 'validacoes', 'solicitacoes_acesso', 'convites_acesso', 'saidas_acesso', 'pedidos_unidade', 'resumos_mensais']) && !souProfessor();
      allow create: if logado() && colecao in ['auditoria_cronograma', 'auditoria_configuracoes'];
    }
  }
}
